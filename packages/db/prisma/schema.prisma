// ── Schedule (蓝图 P1½「排期 + Routine」) ──────────────────────────────────
// UI-first slice: owner/OTTO can build, approve, and queue IG/FB posts, but the
// publish worker is deferred to Meta App Review (see docs/superpowers/specs/
// 2026-07-03-schedule-uifirst-slice-design.md). This slice builds the full
// working-grade schema so slice 2 (real publishing) needs NO further migration.
// $0 path: media reuses already-paid Generation rows; nothing here touches spend.
model ScheduledPost {
  id           String       @id
  ownerId      String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId    String
  // B8 一期: nullable Campaign grouping; a Campaign soft-delete never removes posts.
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId, ownerId], references: [id, ownerId], onDelete: Restrict)
  channel      String       // 'instagram' | 'facebook' (code-validated, not a PG enum — house style)
  // Connected IG business id / FB page id. NULLABLE: an OTTO DRAFT may have no resolved
  // target until the owner picks a connected channel at approve-time. Must belong to the
  // owner's own MetaConnection — server actions verify ownership, never trust a client id.
  metaTargetId String?
  caption      String
  firstComment String?
  scheduledAt  DateTime     // UTC — the scheduler polls on this
  scheduledTz  String       // IANA tz (e.g. "Asia/Kuala_Lumpur"); stored alongside UTC so DST / cross-region display stays correct
  // DRAFT | SCHEDULED | PUBLISHING | PUBLISHED | FAILED | NEEDS_ATTENTION | CANCELLED
  // (code-validated String, not a PG enum — house style; state machine is a pure helper)
  status       String       @default("DRAFT")
  publishMode  String       @default("AUTO") // 'AUTO' | 'REMINDER'
  source       String       // 'otto' | 'owner' (who drafted it)
  approvedAt   DateTime?    // null ⇒ never queued/published; owner approval = consent to publish
  metaPostId   String?      // set after publish (slice 2); idempotency anchor — once set, never re-publish
  lastError    String?
  deletedAt    DateTime?    // soft delete — never hard-delete history
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  media ScheduledPostMedia[]
  attempts PublishAttempt[]
  sharePreviewTokens SharePreviewToken[] // B0-28: seat-less share links minted for this post

  @@unique([id, ownerId])
  @@index([status, scheduledAt])  // scheduler polling (slice 2)
  @@index([ownerId, scheduledAt]) // list / calendar queries
  @@index([ownerId, campaignId, deletedAt])
}

// Join table for a post's media (not a string[] array): carousel ordering + reliable
// add/remove of a single item, race-safe on concurrent edits. generationId references an
// already-PAID Generation (media is NEVER regenerated here) — kept as a plain String, no
// hard FK, matching how other tables reference generations by id (e.g. ChatMessage.sourceGenerationId).
model ScheduledPostMedia {
  id              String        @id
  scheduledPostId String
  post            ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  generationId    String        // reuse of an already-paid Generation; never regenerated
  position        Int           // carousel order 0..9 (single image = 1 row, carousel = 2..10 rows)

  @@unique([scheduledPostId, position])
}

// Anti-double-publish core (slice 1 builds the table; slice 2's publish worker uses it).
// Before publishing, the worker inserts PublishAttempt(state='APPLYING'); a PARTIAL UNIQUE
// index "only one APPLYING per post" (raw SQL in the migration — Prisma can't express the
// WHERE; same technique as BrandRecord's live nameKey index and refgen's attach index) makes
// the second racing worker's insert fail → it skips. This mirrors the gen worker's fail-closed
// claim. metaPostId is set on APPLIED and, together with ScheduledPost.metaPostId, guarantees
// resume/restart never re-publishes.
model PublishAttempt {
  id              String        @id
  scheduledPostId String
  post            ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  state           String        // 'APPLYING' | 'APPLIED' | 'FAILED' | 'UNCONFIRMED' (code-validated String — house style)
  // UNCONFIRMED (D2): an ambiguous publish that MAY have gone live but whose receipt was lost. It is
  // NOT APPLYING (frees the partial-unique) yet NOT a clean FAILED — handlePublish refuses to
  // re-publish a post with ANY UNCONFIRMED attempt, so a retry can't double-post. Additive-only,
  // no migration: the partial-unique predicate is state='APPLYING', unaffected by the new value.
  startedAt       DateTime      @default(now())
  finishedAt      DateTime?
  // The external post id, once this attempt has one. Written while the attempt is STILL 'APPLYING'
  // (#810 r4 P1-b): the post is live from that instant, so the id must be durable before the claim
  // is released — the same statement that releases it also decides its terminal state ('APPLIED'
  // behind a stamped post, 'UNCONFIRMED' when the row moved). Nothing keys off this column; lock 4
  // reads `state`, recovery reads `creationId`.
  metaPostId      String?
  // L1 (spec §四D lock 3 + §四F recovery): the IG media container id from step ①/② (create+poll),
  // stored BEFORE the media_publish call. On a crash/redelivery the reaper's reconcile re-checks
  // this exact container (idempotent) rather than rebuilding + re-publishing → never double-posts.
  // Null for FB (its /feed has no creation_id; recovery falls back to a recent-posts query).
  creationId      String?
  error           String?

  // A raw partial UNIQUE INDEX on (scheduledPostId) WHERE state = 'APPLYING' lives in the
  // accompanying migration — at most one in-flight attempt per post. Prisma can't model a
  // partial index, so no @@unique is declared here.
  @@index([scheduledPostId])
}

// 2026-07-04 盲区修复(可观测性):worker 活性心跳,单行(id="worker"),worker 每 60s
// upsert;/api/health 读它给外部监控服务判活。无租户数据(平台级),不进 tenant guard。
//
// #797:再加两列部署身份。「worker 活着」答不了「web 与 worker 是不是同一个部署」——
// 半成功的部署会留下一新一旧,或者两边代码同版但共享密钥不同(#569 的形状)。两列都可空:
// 平台没注入 sha 时写 null,绝不假造一个。configFingerprint 是 8 位摘要,原始密钥不进库。
model WorkerHeartbeat {
  id                String   @id
  at                DateTime
  commitSha         String?
  configFingerprint String?
}

// #794 备份可信化(工程评估债 #2)。此前「昨晚备份成功了吗」这个问题在系统里没有答案:
// 备份成功只写进 worker 的 stdout,失败只进 Sentry,两者都不是可以被 /api/health 或
// admin 读到的事实。备份是否新鲜必须是一行可查的记录,而不是一句日志。
//
// append-only:每次备份尝试落一行(成功与失败都落),**UPDATE 与 DELETE 都被行级触发器
// 硬拦**(Prisma 建模不了触发器,故只在迁移里)。改写能伪造新鲜度,删除同样能——删掉
// 「成功之后的那条失败」会让 admin 那一格从 retry failed 变回全绿。清库用 TRUNCATE
// (表级,不触发行级触发器)。新鲜度 = 最近一条 status='succeeded' 行的 finishedAt
// (见 apps/web/lib/health.ts)。无租户数据(平台级 ops 记录),不进 tenant guard;
// 写入方经 runAsSystem("db-backup") 立帧。
//
// 三个封闭集(status / credentialMode / trigger)与「succeeded 必须带 finishedAt+key」用 CHECK
// 约束守着,同样只在迁移里(Prisma 建模不了 CHECK)——见 migrations/20260811100000_backup_run。
model BackupRun {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  // 'succeeded' | 'failed'(封闭集,迁移里有 CHECK 约束)
  status         String
  // 谁触发的:'cron'(Railway cron,#794 后的权威) | 'worker-timer'(旧的 5 分钟循环) | 'manual'
  trigger        String
  // 这次上传用的是哪一族 R2 凭据:'isolated'(backups/ 专用 token) | 'shared'(与内容同钥匙)。
  // 记在行上而不是读 env:admin 要报的是「上一次真的用了什么」,不是「现在配了什么」。
  credentialMode String
  key            String?
  sizeBytes      BigInt?
  durationMs     Int?
  // 已脱敏的失败摘要(sanitizeError 的输出)。连接串永不进这里。
  error          String?

  @@index([status, finishedAt])
  @@index([startedAt])
}

// ─── L0 量测原语(第 0 大陆:所有环共用的水表)────────────────────────────────
// docs/superpowers/specs/2026-07-10-l0-measurement-primitives.md。PR-L0a:六模型 + 迁移。
// 六件一等公民由 5 个 owner-scoped 对象 + 1 张 placement 支撑表实现。全 $0(不走记账缝),
// 全 ownerId 隔离(六个模型名进 TENANT_MODELS)。本切片只落对象与迁移,无重定向/无写入器。

// L0 量测原语:owner-scoped 短链。重定向端点是公共热路径(匿名点击者),但每条链接
// ownerId 全链隔离 + 目标 allowlist 焊死开放跳转。QR 永远编码短链 URL(不编码 targetUrl),
// 这样吊销短链即可让已印刷的码集中失效,无需重印(物理攻击面对策,§六)。生成 = $0,不扣 credits。
model TrackedLink {
  id           String    @id // ULID
  ownerId      String
  organization Organization @relation(fields: [ownerId], references: [id])
  // v1 additive:未来 agency/campaign 层的 nullable 软引用(无 FK、无 backfill;house 惯例,见 GenerationBatch)
  brandId       String?
  campaignId    String?
  domain        String    // 短链域名(config 层选型,§十);多域名就绪
  slug          String    // 短码,如 "raya-h7";server 铸造 / 校验唯一,永不信客户端裸传
  targetUrl     String    // 最终目的地;写入时刻必过 allowlist,重定向时刻再校验一次(纵深防御)
  targetKind    String    // 'wa' | 'shopee' | 'easystore' | 'gbp_review' | 'own_site' | 'other'(封闭类目,校验用)
  utmJson       Json?     // { source, medium, campaign, content, term };重定向时附加到 targetUrl
  purpose       String    @default("generic") // 'generic' | 'review_request' | 'winback' | 'promo'(报表分组;'review_request' 触发请评护栏 §七)
  title         String    @default("") // 人话标签
  status        String    @default("active") // 'active' | 'revoked'(code-validated String,非 PG enum;house style)
  revokedAt     DateTime?
  revokedReason String?
  source        String    // 'otto' | 'owner'(谁建的)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // 软删除——永不硬删历史

  qrAssets QrAsset[]

  // 重定向解析 (domain, slug) → link,与 owner 无关(点击者匿名),故唯一约束在 (domain, slug)。
  // 一条 raw partial UNIQUE INDEX ON (domain, slug) WHERE deletedAt IS NULL 落 migration
  // (Prisma 无法表达 partial index;同 BrandRecord.nameKey / PublishAttempt 手法)。
  @@unique([id, ownerId])
  @@index([ownerId, createdAt])
  @@index([ownerId, purpose, createdAt]) // 报表:按用途聚合
}

// QR 永远编码一条 TrackedLink 的短链 URL(linkId 必填),绝不编码 targetUrl —— 这是可吊销性的根:
// 撤链接即让所有印出去的码集中跳向品牌中间页,无需重印。渲染出的 QR PNG 走内容寻址存储
// (storageKey(ownerId, sha256, "png"));生成 = $0。
model QrAsset {
  id           String    @id // ULID
  ownerId      String
  organization Organization @relation(fields: [ownerId], references: [id])
  brandId      String?
  campaignId   String?
  linkId       String    // FK→TrackedLink;QR 的一切扫码事件经这条短链抄表
  link         TrackedLink @relation(fields: [linkId, ownerId], references: [id, ownerId], onDelete: Cascade)
  label        String    // "Raya 海报 / GM Klang 门店橱窗"
  imageAssetId String?   // 渲染好的 QR PNG(R2,可选;也可前端即时渲染)
  status        String    @default("active") // 'active' | 'revoked'
  revokedAt     DateTime?
  revokedReason String?
  source        String    // 'otto' | 'owner'
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  placements QrPlacement[]

  @@unique([id, ownerId])
  @@index([ownerId, linkId])
}

// placement ledger:一张码贴在哪、第几版、印刷/铺设/召回到哪一步。码一旦印刷,
// 错误无法靠部署回滚(R5 Q3 3.7),故物理放置本身是「有版本、有位置、有撤销成本」的资产。
model QrPlacement {
  id           String    @id // ULID
  ownerId      String    // 反范式冗余,供 tenant guard 直接过滤
  organization Organization @relation(fields: [ownerId], references: [id])
  qrAssetId    String
  qr           QrAsset   @relation(fields: [qrAssetId, ownerId], references: [id, ownerId], onDelete: Cascade)
  location     String    // 人话:"GM Klang 门店橱窗" / "Raya 海报 A 批"
  version      Int       @default(1) // 重印版本;换码即 version+1
  printStatus  String    @default("DRAFT") // 'DRAFT' | 'PRINTED' | 'DEPLOYED' | 'RECALLED'(code-validated;状态机是纯 helper)
  quantity     Int?      // 印了多少张贴纸/海报
  deployedAt   DateTime?
  recalledAt   DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([ownerId, qrAssetId, printStatus])
}

// 商家发给自家顾客的一次性营销码,顾客在商家店里核销。二值生命周期(issued→redeemed/void/expired
// + clawed_back),不是余额账本(与 loyalty 积分余额严格区分:后者只读自商家店铺,L0 不建)。
// 核销/回卷的**事实**来自 source-observed(店铺 webhook)或 merchant-confirmed;不经手资金。
// 生成 = $0。⚠️ 宪法第 8 条 v2.11:优惠/奖励与「请评」永久分离——voucher 永不可挂在写评价动作上(§七)。
model VoucherToken {
  id           String    @id // ULID
  ownerId      String
  organization Organization @relation(fields: [ownerId], references: [id])
  brandId      String?
  campaignId   String?
  code         String    // 可核销码,如 "RAYA-9F3K";server 铸造 / 校验唯一
  kind         String    @default("no_discount") // 'no_discount' | 'percent' | 'amount' | 'gift'
                         // 默认无折扣(§八 量测即干预:优先无折扣 token,折扣是会改变行为的 treatment)
  discountJson Json?     // { percent } | { amountMinor, currency } | { giftSku };no_discount 时为 null
  linkId       String?   // 可选:优惠码经某条短链/QR 派发(软引用,无 FK)
  status       String    @default("issued") // 'issued' | 'redeemed' | 'clawed_back' | 'void' | 'expired'
  issuedAt     DateTime  @default(now())
  redeemedAt   DateTime?
  clawedBackAt DateTime?
  startsAt     DateTime? // 有效期起(读时判过期,永不后台 job;同 BrandRecord offers 手法)
  endsAt       DateTime?
  externalOrderId    String? // 核销对应的商家订单号(source-observed 真相锚点)
  redemptionEvidence String? // 'source_observed' | 'merchant_confirmed'(核销事实的证据级别)
  source       String    // 'otto' | 'owner'
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // 一条 raw partial UNIQUE INDEX ON (ownerId, code) WHERE deletedAt IS NULL 落 migration —— 每 owner 一个活码。
  @@index([ownerId, status, endsAt])
}

// 某人扫码/点链后又成为联系人(WhatsApp 找上门等),把「他从哪张码来」贴到这个主体上。
// CRM/Contact 尚未进 live 库(Sol 已核 schema),故 subjectRef 用 nullable 软引用形态承接:
// 现在挂 phone/wa_id/anon 会话键,CRM 落地后经同一列 scope 到 contactId,零迁移。
model SourceTag {
  id           String    @id // ULID
  ownerId      String
  organization Organization @relation(fields: [ownerId], references: [id])
  brandId      String?
  campaignId   String?
  subjectKind  String    // 'contact' | 'phone' | 'wa_id' | 'anon'(打标对象类型)
  subjectRef   String    // 未来 CRM contactId 软引用 | 电话 | wa_id | 匿名会话键
  linkId       String?   // 来源短链(软引用,无 FK)
  qrAssetId    String?   // 来源 QR(软引用,无 FK)
  voucherId    String?   // 在场的优惠码(软引用,无 FK)
  utmSnapshot  Json?     // 成为来源那一刻捕获的 UTM
  evidence     String    // 'source_observed'(扫/点已记录) | 'merchant_confirmed'
  firstSeenAt  DateTime  @default(now())
  source       String    // 'otto' | 'owner'
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([ownerId, subjectKind, subjectRef])
  @@index([ownerId, linkId])
}

// 只进不改的流水账(append-only),承载全部量测事件。核心纪律(R5 D4):evidence 是**二值封闭集**
// { 'observed' | 'attributed' } —— 写入器**硬拒** 'incremental' 及任何集外值(fail-closed):
// L0 无对照实验,一个被核销的码永远不是「Otto 造成了这单」的证据。这与 ModelRegistryOverlay
// 「只能收窄、永不能加」同构:证据字段永远够不到 incremental 那一格。
// outcomeDelta 用**有符号增量**让退款回卷干净反冲(镜像 CreditLedger 的双 delta 可重建不变量):
// redeem 事件 +1,clawback 事件 -1,净归因 = Σ outcomeDelta。
model AttributionEvent {
  id           String    @id // ULID
  ownerId      String
  organization Organization @relation(fields: [ownerId], references: [id])
  brandId      String?
  campaignId   String?
  kind         String    // 'scan' | 'click' | 'source_tag' | 'redeem' | 'clawback' | 'outcome_link'(封闭集)
  // 产生它的仪表(软引用,按 kind 至少一个非空):
  linkId       String?
  qrAssetId    String?
  voucherId    String?
  sourceTagId  String?
  // 证据:二值——'observed'(亲眼看到的事件)| 'attributed'(经启发式/模型关联到下游成果)。
  // 'incremental' 永久禁写。细鳞(源观测/商家确认/关联/模型归因)折进 evidenceRung 供内部报表,
  // 但对外报表桶只有 observed / attributed 两格。写入器封闭校验在 PR-L0d 落地(本切片只落列)。
  evidence     String    // 'observed' | 'attributed'(写入器封闭校验,拒 'incremental')
  evidenceRung String?   // 'source_observed' | 'merchant_confirmed' | 'associated' | 'model_attributed'(内部细分,永不含 incremental)
  outcomeDelta Int       @default(0) // +1 归因成果 / -1 回卷 / 0(scan/click/source_tag)
  valueMinor   Int?      // 订单金额(minor units,source-observed);未知则 null
  valueCurrency String?
  utmSnapshot  Json?     // 抄表那一刻的 UTM
  // 反滥用可观测性(§六 异常扫描)—— 只存粗粒度、隐私安全信号(PDPA,§十):
  geoBucket    String?   // 粗区域桶(国家/州),永不精确定位
  deviceBucket String?   // 粗设备类,永不指纹
  ipHashPrefix String?   // 截断+哈希,仅限速率/异常,不作身份
  idempotencyKey String  // 精确一次:'redeem:<voucherId>' | 'clawback:<externalOrderId>' | 'scan:<dedupHash>'
  occurredAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  // 精确一次(双 webhook / 双扫防重放):(ownerId, idempotencyKey) 全域唯一。idempotencyKey NOT NULL、
  // 无 partial 谓词,故用 Prisma @@unique 建模(镜像 CreditLedger.@@unique([orgId, idempotencyKey]));
  // 这样漂移门可见、迁移由 prisma 自动生成——与「raw 仅用于 Prisma 表达不了的 partial 索引」的房规一致。
  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, kind, occurredAt])
  @@index([ownerId, campaignId, occurredAt]) // campaign 级报表
}
