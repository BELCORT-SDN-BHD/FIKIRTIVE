// Fikirtive schema — implements design doc D14 (dual identity: ULID PK + content-hash
// storage key), D21 (soft delete + 30-day window + refcount sweep), E4-pre
// (recipe-ready structured generation fields), A3 lesson (owner_id reserved on
// every business table from day 1; single owner "founder" until multi-user).
//
//   Entity ─< ReferenceImage >─ Asset            Asset ─< Generation
//   Project ─< Shot ─< ShotEntityRef >─ Entity   Shot ─< Generation (nullable: 候选区)
//
// IDs are app-supplied ULIDs (via @fikirtive/core newId()). History rows
// (Generation) are immutable: entitySnapshot freezes names + ref hashes at
// generation time, so renames/deletes never corrupt provenance.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntityType {
  CHARACTER
  LOCATION
  PRODUCT
  BRANDMARK
}

// 镜头状态机（最小四态，design doc 阶段一定义）
enum ShotStatus {
  DRAFT
  EXPORTED
  ATTACHED
  FINAL
}

enum AssetSource {
  UPLOAD
  MODAL
  IMPORT
  RENDER
  GENERATED // Phase 2: reference images produced by a generation provider (fal/mock)
}

// Phase A redesign: per-mode reference generation. REFSHEET = legacy multi-view
// (default for pre-existing rows); BASE = single t2i identity anchor; VARIANT =
// single i2i look conditioned on the base (Phase B).
enum RefGenMode {
  REFSHEET
  BASE
  VARIANT
}

model Project {
  id        String    @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  name      String
  /// 编辑器的工作中剪辑（fikirtiveEdit 规范化后的 JSON）——阶段③ tracer 落地，
  /// 取代 localStorage mock；导出时快照进 RenderJob.editJson
  editJson     Json?
  // cowork: human-authored creative brief, injected into the planner's stable head (ProjectBrief).
  coworkBrief  String?
  // v1 additive: nullable soft-refs for future agency layer (no FK, no backfill)
  brandId      String?
  campaignId   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  pinnedAt  DateTime?
  deletedAt DateTime?

  shots       Shot[]
  generations Generation[]

  @@index([ownerId, deletedAt])
  @@index([ownerId, pinnedAt, createdAt], map: "Project_owner_pinned_idx")
}

// 实体跨项目复用（属于 owner 而非 project）—— journey step 7
model Entity {
  id                  String     @id
  ownerId             String
  organization Organization @relation(fields: [ownerId], references: [id])
  type                EntityType
  name                String
  aliases             String[]   @default([])
  notes               String     @default("")
  negativeConstraints String     @default("")
  // cowork: reserved — structured see-once description (subject/action/style/...), populated by the Phase-C vision sub-agent.
  descriptionJson     Json?
  promptTokens        String[]   @default([])
  // v1 additive: nullable soft-ref for future agency layer (no FK, no backfill)
  brandId             String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?
  // locked canonical base image (an Asset id); soft pointer (no FK) — re-validated
  // live in refgen-actions before any mode=VARIANT spend. Safe from the D21 sweep
  // while a base-level ReferenceImage points at the same asset.
  baseAssetId         String?

  referenceImages ReferenceImage[]
  variants        EntityVariant[]
  shotRefs        ShotEntityRef[]

  @@index([ownerId, type, deletedAt])
}

// Phase B: named look/outfit/angle variant of an entity. A thin registry — its
// image(s) are ReferenceImage rows tagged with variantId. handle uniqueness is a
// PARTIAL unique index (live rows only) added in migration.sql (Prisma can't
// express conditional uniqueness).
model EntityVariant {
  id        String    @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  entityId  String
  name      String
  handle    String
  prompt    String    @default("")
  // cowork: reserved — per-variant structured description (Phase C).
  descriptionJson Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  entity          Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict)
  referenceImages ReferenceImage[]

  @@index([ownerId, deletedAt])
  @@index([entityId, deletedAt])
}

model ReferenceImage {
  id        String    @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  entityId  String
  assetId   String
  position  Int       @default(0)
  note      String    @default("")
  // 视角标签：阶段二的视角级缺图检查用（CEO 评审 D12 计数制裁决预留）
  viewTag   String?
  // null = base/entity-level ref; set = belongs to that variant (Phase B)
  variantId String?
  // v1 additive: nullable soft-ref for future agency layer (no FK, no backfill)
  brandId   String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  entity  Entity         @relation(fields: [entityId], references: [id])
  asset   Asset          @relation(fields: [assetId], references: [id])
  variant EntityVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // 防并发重复挂靠靠迁移里的 PARTIAL UNIQUE 索引(Prisma 无法在 schema 表达条件唯一,
  // 故只在 20260703000000_reference_image_live_uniqueness/migration.sql 里建):同一
  // (entityId, assetId, COALESCE(variantId,'')) 同时只能有一行 live(deletedAt IS NULL)。
  // attachOutputs 的 findFirst-then-create TOCTOU(reaper 复活 vs 在途投递并发重挂)和
  // 同图重复上传(assetUpsert 内容去重到同一 Asset)都被 DB 层挡住;创建方捕获 P2002
  // 跳过(并发赢家已挂上)。COALESCE 是承重的:variantId NULL 在 PG 里彼此 DISTINCT。

  @@index([entityId, deletedAt])
  @@index([entityId, variantId, deletedAt])
  @@index([assetId])
}

// 内容寻址资产：storage key 永远由 u/<ownerId>/<contentHash>.<ext> 推导，
// 数据库永不存路径（D14）。同 hash 仅存一份（去重），删除走引用计数清扫（D21）。
// 清扫合同：sweep 只删 R2 blob，Asset 行永存为墓碑（Generation FK Restrict 使行删除永不可行——这是设计而非缺陷）。
model Asset {
  id               String      @id
  ownerId          String
  organization Organization @relation(fields: [ownerId], references: [id])
  contentHash      String
  ext              String
  mime             String
  sizeBytes        BigInt
  originalFilename String      @default("")
  source           AssetSource @default(UPLOAD)
  width            Int?
  height           Int?
  durationS        Float?
  // v1 additive: nullable soft-ref for future agency layer (no FK, no backfill)
  brandId          String?
  createdAt        DateTime    @default(now())
  deletedAt        DateTime?

  referenceImages ReferenceImage[]
  generations     Generation[]

  @@unique([ownerId, contentHash])
  @@index([ownerId, deletedAt])
  @@index([deletedAt]) // 跨 owner 的 30 天清扫扫描
}

model Shot {
  id                     String     @id
  projectId              String
  ownerId                String
  organization Organization @relation(fields: [ownerId], references: [id])
  number                 Int
  // 场景分组（storyboard 多场景）：同一 scene 内按 number 排序；number 仍全局唯一
  scene                  Int        @default(1)
  title                  String     @default("")
  description            String     @default("")
  status                 ShotStatus @default(DRAFT)
  // Tiptap 结构化文档：芯片只存实体 ID（label 仅显示缓存，D12 设计裁决）
  promptDoc              Json?
  // 段模型（storyboard segment，布局 A）：首帧/尾帧的 Generation id（图）；
  // Animate 用首帧作 i2v source、尾帧作 tail（可选）。存 id 不建关系（避免与 generations 关系歧义）。
  firstFrameGenerationId String?
  lastFrameGenerationId  String?
  // 段转场（③C）：null=无；"in"/"out"/"both" → buildBoardEdit 映射成 clip.transition 的 fade（0.5s 默认）
  transition             String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  deletedAt              DateTime?

  project     Project         @relation(fields: [projectId], references: [id])
  entityRefs  ShotEntityRef[]
  generations Generation[]

  @@unique([projectId, number])
  @@index([projectId, status, deletedAt])
  // 扩容覆盖索引（scale audit 2026-06-20）：getShots 按 [scene asc, number asc] 排序，
  // 让 WHERE(ownerId,projectId,deletedAt)+ORDER BY(scene,number) 全走索引。
  @@index([ownerId, projectId, deletedAt, scene, number], map: "Shot_order_idx")
}

// promptDoc 芯片的派生索引：实体使用计数（"14 镜引用"）与删除前引用检查用。
// 保存镜头时重建，不是真相源（真相源是 promptDoc）。
model ShotEntityRef {
  shotId   String
  entityId String
  ownerId  String
  organization Organization @relation(fields: [ownerId], references: [id])

  shot   Shot   @relation(fields: [shotId], references: [id])
  entity Entity @relation(fields: [entityId], references: [id])

  @@id([shotId, entityId])
  @@index([entityId])
}

// 生成历史：不可变（永不物理删，deletedAt 仅作隐藏/候选区移除）。
// 可变字段白名单：shotId, version, attachedAt, deletedAt, favorite —— 其余字段写入后冻结。
// E4-pre：prompt/模型/参数/实体引用分字段存储而非整段文本 —— 配方功能阶段二直接站上来。
model Generation {
  id             String      @id
  ownerId        String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId      String
  shotId         String? // null = 候选区"未挂载"
  assetId        String
  source         AssetSource
  promptText     String      @default("")
  // 模板/模型标识（阶段一=模板 slug@version；阶段二=模型注册表条目）
  modelRef       String      @default("")
  params         Json?
  // 不可变快照：生成当时的实体名 + 参考图内容哈希（改名/删除不破历史）。
  // 必填：无实体引用时存 {"entities":[]} —— 可空会诱使写入端遗忘。
  entitySnapshot Json
  // 同一镜头下的版本序号（v1, v2, …）
  version        Int         @default(1)
  threadId       String?   // set by the worker (= GenJob.threadId) when a cowork gen produced this; filters it out of candidate/asset/editor views
  // v1 additive: nullable soft-ref for GenerationBatch grouping (no FK, no backfill)
  batchId        String?
  favorite       Boolean     @default(false)
  attachedAt     DateTime?
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id])
  shot    Shot?   @relation(fields: [shotId], references: [id], onDelete: Restrict)
  asset   Asset   @relation(fields: [assetId], references: [id])

  @@index([projectId, shotId, deletedAt])
  @@index([ownerId, shotId, deletedAt, createdAt]) // 候选区查询：shotId IS NULL，按时间倒序
  // 扩容覆盖索引（scale audit 2026-06-20）：getProjectMedia 与 getCandidates 是每次
  // studio/editor 渲染的热查询，等值列在前、createdAt 排序列在后，让 WHERE+ORDER BY 全走索引。
  @@index([ownerId, projectId, threadId, deletedAt, createdAt, id], map: "Generation_media_idx") // getMediaPage: 资产库 keyset 分页（id 是 createdAt 并列的 tiebreak，让 ORDER BY createdAt,id 全走索引）
  @@index([ownerId, projectId, shotId, threadId, deletedAt, createdAt], map: "Generation_candidates_idx") // getCandidates: 候选区（shotId/threadId IS NULL）
  // (shotId, version) 唯一性改由迁移里的 PARTIAL 索引保证（WHERE shotId IS NOT NULL
  //  AND deletedAt IS NULL）——只约束 LIVE 已附着行，让删除后的版本可被复用。Prisma
  //  无法表达条件唯一，故不在此声明 @@unique（旧的非部分索引已在迁移里 DROP）。
  @@index([assetId])
  // G5a: unified library keyset — newest-first over ALL of a project's generations
  // (no threadId filter, unlike Generation_media_idx). Additive, no backfill.
  @@index([ownerId, projectId, deletedAt, createdAt, id], map: "Generation_library_idx")
  // Owner-global Library keyset — newest-first across every project/campaign.
  @@index([ownerId, deletedAt, createdAt, id], map: "Generation_owner_library_idx")
}

// ComfyUI 模板注册表（SOP v1.1 A3.5 文件版 registry.json 的站内镜像；
// M0 启动时导入，阶段二起成为真相源）
model TemplateBundle {
  id            String    @id
  ownerId       String
  organization Organization @relation(fields: [ownerId], references: [id])
  slug          String
  version       Int
  versionHash   String    @unique // workflow_api.json 原始字节 SHA-256
  displayName   String
  slots         Json // SlotBinding[]（@fikirtive/core）
  // zip 位置永远由哈希推导：bundles/<zipHash>.zip（D14：不存路径）
  zipHash       String    @unique
  modalEndpoint String?
  gpu           String?
  costUsdPerRun Float?
  deprecatedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([slug, version])
  @@index([ownerId, slug])
}

// 剪辑渲染任务（编辑器切片合同的一半；另一半是 @fikirtive/core 的 fikirtiveEdit zod）。
// 三保险第一式：行先于 pg-boss 派发持久化——队列丢失永远不孤儿化一次渲染。
// editJson 在写入前必须过 fikirtiveEdit.parse（web 端校验，worker 端复验）。
enum RenderStatus {
  QUEUED
  RENDERING
  DONE
  FAILED
}

model RenderJob {
  id            String       @id
  ownerId       String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId     String
  editJson      Json
  status        RenderStatus @default(QUEUED)
  /// 0-100，worker 从 ffmpeg -progress 回写
  progress      Int          @default(0)
  /// DONE 时指向产出 MP4 的 Asset（内容寻址，与所有媒体同一套语义）
  outputAssetId String?
  error         String       @default("")
  /// 队列侧关联（codex 审核补全：可审计的重试与对账）
  queueJobId    String       @default("")
  attempts      Int          @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId, createdAt])
  @@index([status, updatedAt]) // 滞留 RENDERING 行的清扫扫描
}

model CaptionJob {
  id            String       @id
  ownerId       String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId     String
  /// the visual-track asset being transcribed (content-addressed) + its hash
  assetId       String
  contentHash   String
  status        RenderStatus @default(QUEUED)
  progress      Int          @default(0)
  error         String       @default("")
  queueJobId    String       @default("")
  attempts      Int          @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId, createdAt])
  @@index([status, updatedAt])
}

/// Cached whisper.cpp transcript, keyed by (contentHash, model). Deterministic
/// for fixed (audio bytes, model, flags) → cache is always valid; a re-render or
/// re-request reuses it for $0 + 0 CPU. cuesJson = CaptionCue[] (the editable seed).
model Transcript {
  id          String   @id
  ownerId     String
  organization Organization @relation(fields: [ownerId], references: [id])
  contentHash String
  model       String
  cuesJson    Json
  createdAt   DateTime @default(now())

  @@unique([contentHash, model])
}

enum GenStatus {
  QUEUED
  GENERATING
  DONE
  FAILED
}

// Phase 2 引导式参考图生成（首个收费点）—— 异步任务，镜像 RenderJob 形态。
// 产物=GENERATED 资产 + 挂到实体的 ReferenceImage。条件输入（logo 等）由
// worker 从实体已有 refs 推导，不入此表（D19 信任边界，合同里也无该字段）。
model RefGenJob {
  id             String     @id
  ownerId        String
  organization Organization @relation(fields: [ownerId], references: [id])
  entityId       String
  prompt         String
  model          String     @default("seedream")
  count          Int
  mode           RefGenMode @default(REFSHEET)
  variantId      String? // set when mode = VARIANT; no FK (validated in app before spend)
  status         GenStatus  @default(QUEUED)
  /// 0-100，worker 按已落地图片数回写
  progress       Int        @default(0)
  /// DONE 时产出的 GENERATED 资产（内容寻址，可多张）
  outputAssetIds String[]   @default([])
  /// 钱真相（OPT-6 P3a，纯记录）：付费 provider 调用提交时由 worker 在同一写入里快照
  /// （= REFGEN_PRICE_USD_PER_IMAGE * count）。null = 没扣过费。绝不参与任何 spend 判定。
  spentUsd       Float?
  error          String     @default("")
  queueJobId     String     @default("")
  attempts       Int        @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  // 防双扣靠迁移里的 PARTIAL UNIQUE 索引（active 键唯一，Prisma 无法在 schema 表达条件
  // 唯一，故只在 migration.sql 里建）：同一 (owner, entity, COALESCE(variant,'')) 同时
  // 只能有一个 QUEUED/GENERATING 任务 → 并发同实体提交 DB 层挡住，不会双扣。base/REFSHEET
  // 的 variantId 为 null（COALESCE 成 '' → 同实体串行）；Phase B 的 VARIANT 各带自己的
  // variantId → 不同 variant 并发。startRefGen 捕获 P2002 后复用在途任务（镜像 startGen）。

  @@index([entityId, createdAt])
  @@index([status, updatedAt]) // 滞留 GENERATING 行的清扫扫描
}

enum GenKind {
  IMAGE
  VIDEO
}

// 镜头/会话生成任务（redesign Gen space）—— 产出 Generation 候选，镜像 RefGenJob。
// 条件输入由 worker 从 entityIds 推导（D19）。
model GenJob {
  id                 String    @id
  ownerId            String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId          String
  shotId             String?
  // i2v source = a specific owned Generation's image (Gen space upload→animate)；
  // worker 校验 owner+project 后用它的图做 image-to-video（D19：不收客户端 URL）
  sourceGenerationId String?
  // 可选末帧（last frame）：i2v 在 source→tail 之间补间（Kling tail_image_url）
  tailGenerationId   String?
  referenceVideoGenerationId String?
  prompt             String
  entityIds          String[]  @default([])
  // Phase C: { [entityId]: variantId } — selected variant per @mentioned entity;
  // null/absent = base refs for all mentions (backward-compat with old rows)
  variantSel         Json?
  // 双提交幂等：shot 绑定生成的稳定键（"frame:<shotId>:<slot>" / "animate:<shotId>"）。
  // startGen 命中同键的在途(QUEUED/GENERATING)任务则复用，重载再点不二次扣费。
  idempotencyKey     String?
  // set when a Cowork gen-card initiated this job (no FK — validated in the action). Lets
  // getRecentGenResults keep cowork gens out of the GenSpace hydrate (WHERE threadId IS NULL).
  threadId           String?
  // v1 additive: nullable soft-ref for GenerationBatch grouping (no FK, no backfill)
  batchId            String?
  kind               GenKind   @default(IMAGE)
  model              String    @default("seedream")
  count              Int       @default(1)
  /// 视频生成的每模型设置（duration/resolution/aspectRatio/fps/audio）；worker 传给 provider
  videoOptions       Json?
  status             GenStatus @default(QUEUED)
  progress           Int       @default(0)
  /// DONE 时产出的 Generation 行（可多个）
  generationIds      String[]  @default([])
  /// 钱真相：付费 provider 调用是否已返回（扣过费）。DONE=已交付；FAILED+spent=付了但没存上
  ///（可审计/对账，避免"失败=没扣费"的误判）。pre-charge 失败时为 false。
  spent              Boolean   @default(false)
  /// 钱真相（OPT-6 P3a，纯记录）：付费调用提交时 worker 在 commit tx 里快照（video=
  /// videoPriceUsd，image=GEN_PRICE_USD_PER_IMAGE*count），冻结如 Generation.entitySnapshot。
  /// null = 没扣过费。绝不参与任何 spend 判定。
  spentUsd           Float?
  error              String    @default("")
  queueJobId         String    @default("")
  attempts           Int       @default(0)
  startedAt          DateTime?
  finishedAt         DateTime?
  /// At-most-once Otto verdict claim: set atomically by the worker after gen DONE.
  /// null = not yet claimed; non-null = claimed (or redelivery — skip).
  ottoVerdictAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // 幂等去重靠迁移里的 PARTIAL UNIQUE 索引（active 键唯一，Prisma 无法在 schema 表达
  // 条件唯一，故只在 migration.sql 里建）：同一 (owner, project, idempotencyKey) 同时
  // 只能有一个 QUEUED/GENERATING 任务 → 并发同键提交 DB 层挡住，不会双扣。

  @@index([projectId, createdAt])
  @@index([status, updatedAt])
  @@index([ownerId, status])
}

// 深度研究任务（Otto 研究 S3）：用户在 RESEARCH_CARD 点 Approve → 建此 job + 入队；
// worker 跑有界 search→read→synthesize 循环并经 withLlmBudget 计量。approve 本身 $0
//（不 reserve/settle）—— 花钱只在 worker。幂等靠迁移里的 `research:%` once-EVER 部分唯一
// 索引（Prisma 无法在 schema 表达条件唯一，故只在 migration.sql 里建）：同一 (owner,
// idempotencyKey) 全状态只能有一条 → 双击/重放 approve DB 层挡住,不会双建 job。
model ResearchJob {
  id              String   @id
  ownerId         String
  organization    Organization @relation(fields: [ownerId], references: [id])
  threadId        String
  cardId          String
  idempotencyKey  String
  tier            String
  status          String   @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED（house style：代码校验的 String,非 PG enum）
  /// worker 起步时 withLlmBudget reserve 的 turnBudget 上限（记录用；approve 时为 null）
  reservedCredits Int?
  /// worker settle 的实际 token 成本（记录用；approve 时为 null）
  actualCredits   Int?
  error           String?
  queueJobId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cardId])
}

// ── Auth.js v5 标准模型（D18：邮箱魔法链接）────────────────────────────
// 业务表的 ownerId 仍恒为 "founder"：登录只是门禁，不是多租户（A3 预留不变）。
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// 操作员 RBAC（OPT-6 P1b）：默认 viewer；值由代码侧 zod 枚举 ROLES 校验（非 PG enum，
  /// 加第 6 个角色无需迁移）。session callback 把它读进 session.user.role；requireRole 用它。
  /// allowlist 仍是外墙、永不读 role —— 默认 viewer 锁不了 app，只锁 role-gated 区段。
  role          String    @default("viewer")
  activeOrgId   String? // RESERVED NOW (future multi-org switcher; avoids an auth-table migration later)
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[] // NEW: per-org membership (per-tenant RBAC lives here)
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── Org-as-tenant root (closed-beta foundation P1) ─────────────────────────────
// An Organization IS the tenant. Every business table's existing `ownerId` is an FK
// to Organization.id. The founder org is SEEDED (in the migration) with the literal
// id "founder" so all existing ownerId="founder" rows + R2 keys (u/founder/<hash>)
// are valid with ZERO backfill. New orgs get ULID ids. DORMANT until P3 (the app
// still resolves ownerId via the FOUNDER_OWNER_ID constant).
model Organization {
  id        String    @id // ULID for new orgs; literal "founder" for the seed (== FOUNDER_OWNER_ID). NEVER change.
  name      String    @default("")
  slug      String?   @unique // future tenant routing; nullable now
  deletedAt DateTime? // RESERVED NOW (account closure / GDPR erasure)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  settings  Json?     // owner-scoped preferences (OwnerSettings shape); null = all defaults

  memberships Membership[]
  creditAccount CreditAccount?
  creditLedger  CreditLedger[]

  @@index([deletedAt, createdAt], map: "Organization_list_idx")
  // business back-relations (one per owner-scoped table; required by Prisma):
  projects                Project[]
  entities                Entity[]
  entityVariants          EntityVariant[]
  referenceImages         ReferenceImage[]
  assets                  Asset[]
  shots                   Shot[]
  shotEntityRefs          ShotEntityRef[]
  generations             Generation[]
  templateBundles         TemplateBundle[]
  renderJobs              RenderJob[]
  captionJobs             CaptionJob[]
  transcripts             Transcript[]
  refGenJobs              RefGenJob[]
  genJobs                 GenJob[]
  actionEvents            ActionEvent[]
  modelDirectives         ModelDirective[]
  modelRegistryOverlays   ModelRegistryOverlay[]
  modelDirectiveRevisions ModelDirectiveRevision[]
  chatThreads             ChatThread[]
  chatMessages            ChatMessage[]
  memories                Memory[]
  generationBatches       GenerationBatch[]
  brandKits               BrandKit[]
  brandRules              BrandRule[]
  brandRecords            BrandRecord[]
  metaConnection          MetaConnection?
  researchJobs            ResearchJob[]
  scheduledPosts          ScheduledPost[]
}

// User <-> Organization join, carrying the per-org role. role/status are code-validated
// Strings (ORG_ROLES / "active"|"suspended"|"revoked"), NOT PG enums. RESERVED columns
// (status/deletedAt/invitedBy) are unused in beta but free to add now.
model Membership {
  id        String    @id // ULID
  userId    String
  orgId     String
  role      String    @default("owner") // ORG_ROLES: owner|admin|member (NOT User.role)
  status    String    @default("active") // RESERVED: active|suspended|revoked
  invitedBy String? // RESERVED (future invites)
  deletedAt DateTime? // RESERVED (revocation audit)
  createdAt DateTime  @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId, role])
  @@index([userId])
}

// DB-backed invite allowlist (closed-beta admin P1). email is lowercased at write
// (mirrors the env ALLOWED_EMAILS normalization so comparisons are case-insensitive by convention).
model AllowedEmail {
  email     String   @id // LOWERCASED at write + compare (mirrors env allowlist normalization)
  status    String   @default("invited") // invited | active | revoked
  invitedBy String // operator email (audit)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Credits ledger (closed-beta foundation P2) — the per-org spend cap (M1) ────────
// CreditAccount = hot mutable counters (Int INTERNAL credits, 1 = $0.01); balance can
// never go negative (the reserve is a conditional UPDATE). CreditLedger = append-only
// audit with TWO signed deltas so balance/reserved fully reconstruct from it
// (balance == Σ balanceDelta, reserved == Σ reservedDelta per org). The charge is a
// deterministic pricedCredits value, so reserve == settle (no variable delta). Worker
// writes (RESERVE/SETTLE/REFUND) are exactly-once via a partial-unique (orgId,refId,kind)
// index added in the migration. A future Stripe purchase is one more GRANT row
// (source=PURCHASE) — zero re-migration.
model CreditAccount {
  orgId     String   @id // == Organization.id (== ownerId)
  balance   Int      @default(0) // spendable now (internal credits); never negative
  reserved  Int      @default(0) // held in-flight
  updatedAt DateTime @updatedAt
  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

enum CreditTxnKind {
  GRANT
  RESERVE
  SETTLE
  REFUND
  ADJUST
}

enum CreditTxnSource {
  ADMIN
  BETA
  PROMO
  PURCHASE // reserved for future Stripe
  SYSTEM
}

model CreditLedger {
  id                    String          @id // ULID
  orgId                 String
  balanceDelta          Int // signed Δ to CreditAccount.balance
  reservedDelta         Int // signed Δ to CreditAccount.reserved
  kind                  CreditTxnKind
  source                CreditTxnSource @default(SYSTEM)
  reason                String          @default("")
  refId                 String? // GenJob.id / RefGenJob.id (1:1 with one job/reservation); null for GRANT/ADJUST
  stripePaymentIntentId String? // reserved for future Stripe
  // v1 additive: nullable soft-ref for future agency layer (no FK, no backfill)
  brandId               String?
  idempotencyKey        String // "grant:<uuid>" | "signup:<orgId>" | "stripe:<eventId>" | "reserve:<refId>" etc.
  createdBy             String          @default("")
  createdAt             DateTime        @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, idempotencyKey])
  @@index([orgId, createdAt])
}

// 升级门埋点（D23）：实质动作事件，系统自动记录，3 项目计数门的数据源
model ActionEvent {
  id        String   @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId String?
  type      String // entity.create | entity.update | shot.create | shot.update | generation.attach | bundle.export
  payload   Json?
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([projectId, type])
}

// cowork 知识库（Phase 0B）：per-(model family × generation mode) 的提示词指令，
// 由 founder 在 /admin/directives 实时编辑，无需重新部署。enhancePrompt skill
// 按 (family, mode) 读取并注入（注入是 Phase 1）。directive 为空 → skill 退回
// family-neutral 基础提示词。rules 是闭合结构（Guardian/Coach 读取，避免二次迁移）。
model ModelDirective {
  id         String   @id
  ownerId    String
  organization Organization @relation(fields: [ownerId], references: [id])
  family     String // "seedream" | "kling" | "veo" | "seedance" | "ltx"
  mode       String // "t2i" | "i2i" | "t2v" | "i2v" | "i2v-tail"
  directive  String   @default("") // the injectable snippet; "" → family-neutral base
  rules      Json? // closed shape: { maxConcurrentMotions?, noTagCommas?, i2vMotionNotScene?, pitfalls?[] }
  notes      String   @default("") // founder's rationale / source
  confidence String   @default("untested") // "high" | "medium" | "low" | "untested"
  enabled    Boolean  @default(true) // off → skill ignores it (family-neutral base)
  source     String   @default("research") // "research" | "founder" | "vision-v2"
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  revisions ModelDirectiveRevision[]

  @@unique([ownerId, family, mode]) // the lookup key; one directive per cell
  @@index([ownerId, family])
}

/// 运行时配置（OPT-6 P1a）：把散在 env 的开关变成 DB 旋钮（vision caps / COWORK_PROVIDER）。
/// key 是代码侧固定枚举；valueJson 由 per-key zod 在读/写两侧校验。读取走 read-through，
/// DB 无值回退 env（见 apps/web/lib/runtime-config.ts）。免重新部署即生效（不缓存）。
model RuntimeConfig {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
  updatedBy String   @default("")
}

/// 模型注册表覆盖层（OPT-6 P2）：能力真相 100% 在 typed catalog（GEN_MODELS /
/// GEN_VIDEO_MODELS / REFGEN_MODELS）；本表只承载 disable 布尔 + advisory notes。
/// 一行永远不能新增模型或放宽上限，只能与 typed menu 交集收窄（停掉一个已有模型）。
/// 校验：modelId 在写入时校验 ∈ 三个 catalog 的并集；未知行在读取侧忽略。
/// 强制点见 startGen / startRefGen / dispatchVariantJob / worker handleGen+handleRefGen。
/// 注意 seedream 耦合：GEN_MODELS=REFGEN_MODELS=["seedream"]，停 seedream = 停所有图像生成。
model ModelRegistryOverlay {
  id        String   @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  modelId   String
  enabled   Boolean  @default(true)
  notes     String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([ownerId, modelId])
}

// 指令编辑历史（R6）：每次 save 写一行快照，用于回滚（比 ActionEvent 更结构化）。
model ModelDirectiveRevision {
  id          String   @id
  directiveId String
  ownerId     String
  organization Organization @relation(fields: [ownerId], references: [id])
  directive   String
  rules       Json?
  confidence  String
  enabled     Boolean
  source      String
  editedBy    String   @default("") // the admin email at save time
  createdAt   DateTime @default(now())

  parent ModelDirective @relation(fields: [directiveId], references: [id], onDelete: Cascade)

  @@index([directiveId, createdAt])
}

// ── Cowork agent loop (SP1) ─────────────────────────────────────────────────
enum ChatRole {
  USER
  AGENT
}

enum ChatMessageKind {
  TEXT
  PLAN
  GEN_CARD
  GEN_RESULT
  DENIAL
  TURN_ERROR
  ACTION_CARD
  BUILD_CARD
  STORYBOARD_CARD
  RESEARCH_CARD
  RESEARCH_REPORT
  PERFORMANCE_CARD
}

// G7: per-org autonomy mode for Otto's ad-write operations
enum AdsAutonomy {
  ASK
  AUTO
}

model ChatThread {
  id        String        @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId String
  title     String        @default("")
  // cowork: reserved — folded older-turns summary (generation logic deferred until long sessions).
  rollingSummary String?
  // otto: serialized RunState (JSON string) for multi-turn continuation. Nullable — existing threads have none.
  ottoState String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  pinnedAt  DateTime?
  deletedAt DateTime?
  messages  ChatMessage[]

  // thread list: a PARTIAL index ON (projectId, ownerId, updatedAt) WHERE deletedAt IS NULL
  // lives in migration.sql (Prisma can't express the WHERE). The full @@index is intentionally
  // omitted — the partial covers every live-thread read; deleted threads are never listed.
  @@index([ownerId, pinnedAt, updatedAt], map: "ChatThread_owner_pinned_idx")
}

model ChatMessage {
  id                 String          @id
  threadId           String
  ownerId            String
  organization Organization @relation(fields: [ownerId], references: [id])
  role               ChatRole
  kind               ChatMessageKind
  seq                Int
  text               String          @default("")
  payload            Json?
  genJobId           String?
  sourceGenerationId String?
  replyToMessageId   String?
  createdAt          DateTime        @default(now())
  deletedAt          DateTime?

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Restrict)

  @@index([threadId, seq])
}

// ── v1 additive: brand memory + generation batch ──────────────────────────────

// Brand-memory notes: editable owner-scoped notes (voice, product facts, etc.)
// that Otto reads as context. brandId is nullable — null = not yet scoped to an
// agency brand (v1 ships with brandId=null; the agency layer adds scoping via the
// existing column, no future migration needed).
model Memory {
  id        String    @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  brandId   String?
  category  String
  content   String
  source    String    // 'otto' | 'user'
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId, brandId, deletedAt])
}

// Brand Record: living brand collections (products / customer segments / offers) for the marketing agent.
// kind/status/source are code-validated Strings, NOT PG enums (house style).
model BrandRecord {
  id           String    @id
  ownerId      String
  organization Organization @relation(fields: [ownerId], references: [id])
  brandId      String?
  kind         String    // 'product' | 'segment' | 'offer' (code-validated, not a PG enum — house style)
  nameKey      String    // normalized name/title — upsert key (see @fikirtive/core brand-records)
  data         Json      // zod-validated per-kind payload; offer dates live in the columns below, NOT here
  status       String    @default("active") // 'active' | 'archived'
  startsAt     DateTime? // offers only
  endsAt       DateTime? // offers only — drives read-time expiry (never a background job)
  source       String    // 'otto' | 'user' (last author, same semantics as Memory.source)
  pinned       Boolean   @default(false)   // products: featured-first injection
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // A raw partial UNIQUE INDEX on (ownerId, COALESCE(brandId,''), kind, nameKey) WHERE deletedAt IS NULL
  // lives in the accompanying migration (same pattern as BrandKit F5) — Prisma can't model partial indexes.
  @@index([ownerId, brandId, kind, deletedAt])
}

// Brand Kit: structured brand metadata (colors, fonts, tone, style guide, logo) per owner/brand.
// brandId is nullable — null = not yet scoped to an agency brand (mirrors Memory.brandId convention).
model BrandKit {
  id            String    @id
  ownerId       String
  organization  Organization @relation(fields: [ownerId], references: [id])
  brandId       String?
  name          String?
  colorsJson    Json?     // { primary, secondary, accent, … } freeform JSON
  fonts         String[]  // e.g. ["Inter", "Playfair Display"]
  tone          String?   // e.g. "warm, conversational, approachable"
  styleGuide    String?   // free-text style notes
  logoAssetId   String?   // FK to Asset.id (optional, not enforced — asset may be deleted)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // F5: a raw UNIQUE INDEX on (ownerId, COALESCE(brandId,'')) lives in migration
  // 20260628120000_review_fixes_indexes — dedups kits per owner+brand incl. brandId IS NULL.
  @@index([ownerId, brandId])
}

// Brand Rule: explicit always/never/tone/color constraints for Otto to follow.
// kind ∈ { "always" | "never" | "tone" | "color" }
model BrandRule {
  id           String    @id
  ownerId      String
  organization Organization @relation(fields: [ownerId], references: [id])
  brandId      String?
  kind         String    // "always" | "never" | "tone" | "color"
  text         String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@index([ownerId, brandId, active])
}

// Generation batch: groups multiple GenJob outputs into a single "batch" proposal
// (the ad-pack grouping table). projectId is nullable — batches can be cross-project.
model GenerationBatch {
  id        String    @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId String?
  name      String
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId, projectId, deletedAt])
}

// --- Better Auth (dormant foundation) — own tables, no collision with NextAuth's User/Account/Session/VerificationToken ---
model BetterAuthUser {
  id            String              @id
  name          String
  email         String              @unique
  emailVerified Boolean             @default(false)
  image         String?
  // Better Auth admin plugin fields (default field names — no `schema` override needed).
  role          String?             // BA gate role; MIRROR of canonical User.role (Phase 2). Unused in Phase 1.
  banned        Boolean?            @default(false) // session.create.before hook blocks login when true
  banReason     String?
  banExpires    DateTime?           // plugin auto-clears an expired ban in the session hook
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  sessions      BetterAuthSession[]
  accounts      BetterAuthAccount[]
  @@map("ba_user")
}
model BetterAuthSession {
  id        String         @id
  expiresAt DateTime
  token     String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  ipAddress String?
  userAgent String?
  impersonatedBy String?   // admin's BA user id on an impersonation session (Phase 2). Added now to keep one migration.
  userId    String
  user      BetterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("ba_session")
}
model BetterAuthAccount {
  id                    String         @id
  accountId             String
  providerId            String
  userId                String
  user                  BetterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  @@index([userId])
  @@map("ba_account")
}
model BetterAuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
  @@map("ba_verification")
}

model CanvasNode {
  id           String    @id
  ownerId      String
  projectId    String
  type         String    // "image" | "video" | "text"
  x            Float
  y            Float
  w            Float
  h            Float
  text         String?
  prompt       String?
  generationId String?
  genJobId     String?
  status       String    @default("done") // "pending" | "done" | "failed"
  sourceNodeId String?
  // G4c: convo attribution — which ChatThread created this node. Nullable, no backfill;
  // validated (same owner+project) in createCanvasNode, no FK. null = "unattributed".
  threadId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([ownerId, projectId])
  @@index([ownerId, projectId, threadId])
}

// G6a: a user's connected Meta (Facebook) Ads account. One per owner. The access token is
// AES-256-GCM encrypted at rest (apps/web/lib/token-encryption.ts) and never leaves the server.
model MetaConnection {
  id             String       @id
  ownerId        String       @unique
  // onDelete: Cascade matches the FK 20260628140000_meta_connection created; without it
  // Prisma defaults to Restrict and `migrate dev` keeps trying to recreate the constraint.
  organization   Organization @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  metaUserId     String?
  accessTokenEnc String       // encrypted; never plaintext, never sent to the client
  tokenExpiresAt DateTime?
  scope          String       // "ads_read"
  status         String       @default("active") // "active" | "expired"
  adsAutonomy    AdsAutonomy  @default(ASK)      // per-org Ask/Auto; lost on disconnect → resets to ASK
  adsWritesPaused Boolean     @default(false)    // kill-switch: when true, executor refuses all writes
  canWrite       Boolean      @default(false)    // true only if Meta actually granted ads_management
  canManagePages Boolean      @default(false)    // true if Meta granted pages_manage_ads / pages_read_engagement
  defaultPageId  String?                         // FB Page the org wants to post to by default
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// G7: idempotency table for Otto ad-write steps. One row per (owner, card, step).
model MetaActionExecution {
  id           String   @id
  ownerId      String
  cardId       String
  stepIndex    Int
  status       String   // PENDING | APPLYING | APPLIED | FAILED
  appliedValue Json?
  createdAt    DateTime @default(now())

  // Exactly-once safety index for ad-write steps, created as raw SQL in
  // 20260628150000_g7_ad_write. That migration's comment calls it "partial-unique",
  // but it has no WHERE clause — it's a plain unique index, so it IS expressible
  // here. Modeled so `migrate dev` stops trying to DROP it as drift.
  @@unique([ownerId, cardId, stepIndex], map: "MetaActionExecution_step_once")
}

// Block S1 (Otto research): Nous-style page cache. `fetchAndExtract`'s clean page text
// is cached once by urlHash, then read page-by-page on demand (readPageCached in
// apps/web/lib/web-page-cache.ts). Additive, no FK, no owner scope: it caches PUBLIC web
// pages (SSRF-guarded at fetch time), not tenant data, so a URL fetched by one org can be
// served from cache to another — same public bytes. $0 infra table; money path untouched.
model WebPageCache {
  id        String   @id
  urlHash   String   @unique
  url       String
  title     String   @default("")
  text      String
  fetchedAt DateTime
}

// ── Schedule (蓝图 P1½「排期 + Routine」) ──────────────────────────────────
// UI-first slice: owner/OTTO can build, approve, and queue IG/FB posts, but the
// publish worker is deferred to Meta App Review (see docs/superpowers/specs/
// 2026-07-03-schedule-uifirst-slice-design.md). This slice builds the full
// working-grade schema so slice 2 (real publishing) needs NO further migration.
// $0 path: media reuses already-paid Generation rows; nothing here touches spend.
model ScheduledPost {
  id           String       @id
  ownerId      String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId    String
  channel      String       // 'instagram' | 'facebook' (code-validated, not a PG enum — house style)
  // Connected IG business id / FB page id. NULLABLE: an OTTO DRAFT may have no resolved
  // target until the owner picks a connected channel at approve-time. Must belong to the
  // owner's own MetaConnection — server actions verify ownership, never trust a client id.
  metaTargetId String?
  caption      String
  firstComment String?
  scheduledAt  DateTime     // UTC — the scheduler polls on this
  scheduledTz  String       // IANA tz (e.g. "Asia/Kuala_Lumpur"); stored alongside UTC so DST / cross-region display stays correct
  // DRAFT | SCHEDULED | PUBLISHING | PUBLISHED | FAILED | NEEDS_ATTENTION | CANCELLED
  // (code-validated String, not a PG enum — house style; state machine is a pure helper)
  status       String       @default("DRAFT")
  publishMode  String       @default("AUTO") // 'AUTO' | 'REMINDER'
  source       String       // 'otto' | 'owner' (who drafted it)
  approvedAt   DateTime?    // null ⇒ never queued/published; owner approval = consent to publish
  metaPostId   String?      // set after publish (slice 2); idempotency anchor — once set, never re-publish
  lastError    String?
  deletedAt    DateTime?    // soft delete — never hard-delete history
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  media ScheduledPostMedia[]
  attempts PublishAttempt[]

  @@index([status, scheduledAt])  // scheduler polling (slice 2)
  @@index([ownerId, scheduledAt]) // list / calendar queries
}

// Join table for a post's media (not a string[] array): carousel ordering + reliable
// add/remove of a single item, race-safe on concurrent edits. generationId references an
// already-PAID Generation (media is NEVER regenerated here) — kept as a plain String, no
// hard FK, matching how other tables reference generations by id (e.g. ChatMessage.sourceGenerationId).
model ScheduledPostMedia {
  id              String        @id
  scheduledPostId String
  post            ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  generationId    String        // reuse of an already-paid Generation; never regenerated
  position        Int           // carousel order 0..9 (single image = 1 row, carousel = 2..10 rows)

  @@unique([scheduledPostId, position])
}

// Anti-double-publish core (slice 1 builds the table; slice 2's publish worker uses it).
// Before publishing, the worker inserts PublishAttempt(state='APPLYING'); a PARTIAL UNIQUE
// index "only one APPLYING per post" (raw SQL in the migration — Prisma can't express the
// WHERE; same technique as BrandRecord's live nameKey index and refgen's attach index) makes
// the second racing worker's insert fail → it skips. This mirrors the gen worker's fail-closed
// claim. metaPostId is set on APPLIED and, together with ScheduledPost.metaPostId, guarantees
// resume/restart never re-publishes.
model PublishAttempt {
  id              String        @id
  scheduledPostId String
  post            ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  state           String        // 'APPLYING' | 'APPLIED' | 'FAILED' (code-validated String — house style)
  startedAt       DateTime      @default(now())
  finishedAt      DateTime?
  metaPostId      String?       // set when state = 'APPLIED'
  error           String?

  // A raw partial UNIQUE INDEX on (scheduledPostId) WHERE state = 'APPLYING' lives in the
  // accompanying migration — at most one in-flight attempt per post. Prisma can't model a
  // partial index, so no @@unique is declared here.
  @@index([scheduledPostId])
}

// 2026-07-04 盲区修复(可观测性):worker 活性心跳,单行(id="worker"),worker 每 60s
// upsert;/api/health 读它给外部监控服务判活。无租户数据(平台级),不进 tenant guard。
model WorkerHeartbeat {
  id String   @id
  at DateTime
}
