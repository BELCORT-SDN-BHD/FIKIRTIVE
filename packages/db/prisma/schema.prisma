// Fikirtive schema — implements design doc D14 (dual identity: ULID PK + content-hash
// storage key), D21 (soft delete + 30-day window + refcount sweep), E4-pre
// (recipe-ready structured generation fields), A3 lesson (owner_id reserved on
// every business table from day 1; single owner "founder" until multi-user).
//
//   Entity ─< ReferenceImage >─ Asset            Asset ─< Generation
//   Project ─< Shot ─< ShotEntityRef >─ Entity   Shot ─< Generation (nullable: 候选区)
//
// IDs are app-supplied ULIDs (via @fikirtive/core newId()). History rows
// (Generation) are immutable: entitySnapshot freezes names + ref hashes at
// generation time, so renames/deletes never corrupt provenance.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntityType {
  CHARACTER
  LOCATION
  PRODUCT
  BRANDMARK
}

// 镜头状态机（最小四态，design doc 阶段一定义）
enum ShotStatus {
  DRAFT
  EXPORTED
  ATTACHED
  FINAL
}

enum AssetSource {
  UPLOAD
  MODAL
  IMPORT
  RENDER
  GENERATED // Phase 2: reference images produced by a generation provider (fal/mock)
}

// Phase A redesign: per-mode reference generation. REFSHEET = legacy multi-view
// (default for pre-existing rows); BASE = single t2i identity anchor; VARIANT =
// single i2i look conditioned on the base (Phase B).
enum RefGenMode {
  REFSHEET
  BASE
  VARIANT
}

model Project {
  id        String    @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  name      String
  /// 编辑器的工作中剪辑（fikirtiveEdit 规范化后的 JSON）——阶段③ tracer 落地，
  /// 取代 localStorage mock；导出时快照进 RenderJob.editJson
  editJson     Json?
  // cowork: human-authored creative brief, injected into the planner's stable head (ProjectBrief).
  coworkBrief  String?
  // v1 additive: nullable soft-refs for future agency layer (no FK, no backfill)
  brandId      String?
  campaignId   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  pinnedAt  DateTime?
  deletedAt DateTime?

  shots       Shot[]
  generations Generation[]

  @@unique([id, ownerId])
  @@index([ownerId, deletedAt])
  @@index([ownerId, pinnedAt, createdAt], map: "Project_owner_pinned_idx")
}

// 实体跨项目复用（属于 owner 而非 project）—— journey step 7
model Entity {
  id                  String     @id
  ownerId             String
  organization Organization @relation(fields: [ownerId], references: [id])
  type                EntityType
  name                String
  aliases             String[]   @default([])
  notes               String     @default("")
  negativeConstraints String     @default("")
  // cowork: reserved — structured see-once description (subject/action/style/...), populated by the Phase-C vision sub-agent.
  descriptionJson     Json?
  promptTokens        String[]   @default([])
  // v1 additive: nullable soft-ref for future agency layer (no FK, no backfill)
  brandId             String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?
  // locked canonical base image (an Asset id); soft pointer (no FK) — re-validated
  // live in refgen-actions before any mode=VARIANT spend. Safe from the D21 sweep
  // while a base-level ReferenceImage points at the same asset.
  baseAssetId         String?

  referenceImages ReferenceImage[]
  variants        EntityVariant[]
  shotRefs        ShotEntityRef[]

  @@unique([id, ownerId])
  @@index([ownerId, type, deletedAt])
}

// Phase B: named look/outfit/angle variant of an entity. A thin registry — its
// image(s) are ReferenceImage rows tagged with variantId. handle uniqueness is a
// PARTIAL unique index (live rows only) added in migration.sql (Prisma can't
// express conditional uniqueness).
model EntityVariant {
  id        String    @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  entityId  String
  name      String
  handle    String
  prompt    String    @default("")
  // cowork: reserved — per-variant structured description (Phase C).
  descriptionJson Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  entity          Entity           @relation(fields: [entityId, ownerId], references: [id, ownerId], onDelete: Restrict)
  referenceImages ReferenceImage[]

  @@unique([id, ownerId])
  @@index([ownerId, deletedAt])
  @@index([entityId, deletedAt])
}

model ReferenceImage {
  id        String    @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  entityId  String
  assetId   String
  position  Int       @default(0)
  note      String    @default("")
  // 视角标签：阶段二的视角级缺图检查用（CEO 评审 D12 计数制裁决预留）
  viewTag   String?
  // null = base/entity-level ref; set = belongs to that variant (Phase B)
  variantId String?
  // v1 additive: nullable soft-ref for future agency layer (no FK, no backfill)
  brandId   String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  entity  Entity         @relation(fields: [entityId, ownerId], references: [id, ownerId])
  asset   Asset          @relation(fields: [assetId, ownerId], references: [id, ownerId])
  variant EntityVariant? @relation(fields: [variantId, ownerId], references: [id, ownerId], onDelete: Restrict)

  // 防并发重复挂靠靠迁移里的 PARTIAL UNIQUE 索引(Prisma 无法在 schema 表达条件唯一,
  // 故只在 20260703000000_reference_image_live_uniqueness/migration.sql 里建):同一
  // (entityId, assetId, COALESCE(variantId,'')) 同时只能有一行 live(deletedAt IS NULL)。
  // attachOutputs 的 findFirst-then-create TOCTOU(reaper 复活 vs 在途投递并发重挂)和
  // 同图重复上传(assetUpsert 内容去重到同一 Asset)都被 DB 层挡住;创建方捕获 P2002
  // 跳过(并发赢家已挂上)。COALESCE 是承重的:variantId NULL 在 PG 里彼此 DISTINCT。

  @@index([entityId, deletedAt])
  @@index([entityId, variantId, deletedAt])
  @@index([assetId])
}

// 内容寻址资产：storage key 永远由 u/<ownerId>/<contentHash>.<ext> 推导，
// 数据库永不存路径（D14）。同 hash 仅存一份（去重），删除走引用计数清扫（D21）。
// 清扫合同：sweep 只删 R2 blob，Asset 行永存为墓碑（Generation FK Restrict 使行删除永不可行——这是设计而非缺陷）。
model Asset {
  id               String      @id
  ownerId          String
  organization Organization @relation(fields: [ownerId], references: [id])
  contentHash      String
  ext              String
  mime             String
  sizeBytes        BigInt
  originalFilename String      @default("")
  source           AssetSource @default(UPLOAD)
  width            Int?
  height           Int?
  durationS        Float?
  // v1 additive: nullable soft-ref for future agency layer (no FK, no backfill)
  brandId          String?
  createdAt        DateTime    @default(now())
  deletedAt        DateTime?

  referenceImages ReferenceImage[]
  generations     Generation[]
  understandings  AssetUnderstanding[]

  @@unique([id, ownerId])
  @@unique([ownerId, contentHash])
  @@index([ownerId, deletedAt])
  @@index([deletedAt]) // 跨 owner 的 30 天清扫扫描
}

// #784 素材理解:一件素材被读懂之后留下的那一行。
//
// 商家永远不点「分析」——这些行由 worker 的扫描器自己建、自己排队,商家的体感只是
// 「Otto 好像认识我的店」。行本身就是**幂等键**:(ownerId, assetId, kind) 唯一,所以
// 无论扫描器重跑、pg-boss 重投还是两个副本同时看到同一件素材,同一件事只会被读一次。
//
// 不进 CreditLedger:理解是平台成本,商家一分钱不付(见 @fikirtive/core
// asset-understanding.ts 的铁律 2)。inputTokens/outputTokens 是**记账**,用来事后核对
// 「真的没超预算」,绝不参与任何扣费判定。
//
// kind/status 是代码校验的 String(house style,不建 PG enum)。
model AssetUnderstanding {
  id           String   @id
  ownerId      String
  organization Organization @relation(fields: [ownerId], references: [id])
  assetId      String
  kind         String   // 'image-caption' | 'doc-extract' | 'video-qa'
  status       String   @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED | SKIPPED
  /// 商家读得到的那一句(Otto 取回时说的就是它)。白标,落盘前过 redact。
  summary      String   @default("")
  /// 该 kind 的结构化产物(ImageCaptionData / DocExtractData / VideoQaData)。
  data         Json?
  /// 记账口径,不参与扣费。null = 还没跑过 / 跑了但供应商没回用量。
  inputTokens  Int?
  outputTokens Int?
  /// SKIPPED 的原因,或 FAILED 的白标措辞。
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  asset Asset @relation(fields: [assetId, ownerId], references: [id, ownerId])

  // 幂等键。同一件素材的同一种理解,全状态只允许一行 —— 重跑不重算,也不会重复落
  // BrandRecord 产品行或品牌记忆。
  @@unique([ownerId, assetId, kind])
  // Otto 取回:某租户最近读懂了什么。
  @@index([ownerId, status, createdAt])
  // 清道夫:滞留 RUNNING 的行。
  @@index([status, updatedAt])
}

model Shot {
  id                     String     @id
  projectId              String
  ownerId                String
  organization Organization @relation(fields: [ownerId], references: [id])
  number                 Int
  // 场景分组（storyboard 多场景）：同一 scene 内按 number 排序；number 仍全局唯一
  scene                  Int        @default(1)
  title                  String     @default("")
  description            String     @default("")
  status                 ShotStatus @default(DRAFT)
  // Tiptap 结构化文档：芯片只存实体 ID（label 仅显示缓存，D12 设计裁决）
  promptDoc              Json?
  // 段模型（storyboard segment，布局 A）：首帧/尾帧的 Generation id（图）；
  // Animate 用首帧作 i2v source、尾帧作 tail（可选）。存 id 不建关系（避免与 generations 关系歧义）。
  firstFrameGenerationId String?
  lastFrameGenerationId  String?
  // 段转场（③C）：null=无；"in"/"out"/"both" → buildBoardEdit 映射成 clip.transition 的 fade（0.5s 默认）
  transition             String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  deletedAt              DateTime?

  project     Project         @relation(fields: [projectId, ownerId], references: [id, ownerId])
  entityRefs  ShotEntityRef[]
  generations Generation[]

  @@unique([id, ownerId])
  @@unique([projectId, number])
  @@index([projectId, status, deletedAt])
  // 扩容覆盖索引（scale audit 2026-06-20）：getShots 按 [scene asc, number asc] 排序，
  // 让 WHERE(ownerId,projectId,deletedAt)+ORDER BY(scene,number) 全走索引。
  @@index([ownerId, projectId, deletedAt, scene, number], map: "Shot_order_idx")
}

// promptDoc 芯片的派生索引：实体使用计数（"14 镜引用"）与删除前引用检查用。
// 保存镜头时重建，不是真相源（真相源是 promptDoc）。
model ShotEntityRef {
  shotId   String
  entityId String
  ownerId  String
  organization Organization @relation(fields: [ownerId], references: [id])

  shot   Shot   @relation(fields: [shotId, ownerId], references: [id, ownerId])
  entity Entity @relation(fields: [entityId, ownerId], references: [id, ownerId])

  @@id([shotId, entityId])
  @@index([entityId])
}

// 生成历史：不可变（永不物理删，deletedAt 仅作隐藏/候选区移除）。
// 可变字段白名单：shotId, version, attachedAt, deletedAt, favorite —— 其余字段写入后冻结。
// E4-pre：prompt/模型/参数/实体引用分字段存储而非整段文本 —— 配方功能阶段二直接站上来。
model Generation {
  id             String      @id
  ownerId        String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId      String
  shotId         String? // null = 候选区"未挂载"
  assetId        String
  source         AssetSource
  promptText     String      @default("")
  /// #776 生成回执:引擎自报**它真正跑的那句提示词**(服务端改写/加固之后的版本)。
  /// 商家可见 —— 「每个东西都要有迹可循」:商家写的那句在 promptText,引擎实际跑的那句在这里。
  /// null = 引擎没报(或迁移前的历史行)= **未知**,读取端必须如实说不知道,不得回落成
  /// promptText 冒充引擎的话。展示前过 redactProviderNames(白标)。
  finalPromptText String?
  // 模板/模型标识（阶段一=模板 slug@version；阶段二=模型注册表条目）
  modelRef       String      @default("")
  params         Json?
  // 不可变快照：生成当时的实体名 + 参考图内容哈希（改名/删除不破历史）。
  // 必填：无实体引用时存 {"entities":[]} —— 可空会诱使写入端遗忘。
  entitySnapshot Json
  // 同一镜头下的版本序号（v1, v2, …）
  version        Int         @default(1)
  threadId       String?   // set by the worker (= GenJob.threadId) when a cowork gen produced this; filters it out of candidate/asset/editor views
  // v1 additive: nullable soft-ref for GenerationBatch grouping (no FK, no backfill)
  batchId        String?
  // B8 一期: one generation belongs to zero or one Campaign. Nullable + SetNull keeps
  // historical output rows when a Campaign is physically removed; normal removal is soft-delete.
  campaignId     String?
  favorite       Boolean     @default(false)
  attachedAt     DateTime?
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?

  project Project @relation(fields: [projectId, ownerId], references: [id, ownerId])
  shot    Shot?   @relation(fields: [shotId, ownerId], references: [id, ownerId], onDelete: Restrict)
  asset   Asset   @relation(fields: [assetId, ownerId], references: [id, ownerId])
  campaign Campaign? @relation(fields: [campaignId, ownerId], references: [id, ownerId], onDelete: Restrict)

  @@index([projectId, shotId, deletedAt])
  @@index([ownerId, shotId, deletedAt, createdAt]) // 候选区查询：shotId IS NULL，按时间倒序
  // 扩容覆盖索引（scale audit 2026-06-20）：getProjectMedia 与 getCandidates 是每次
  // studio/editor 渲染的热查询，等值列在前、createdAt 排序列在后，让 WHERE+ORDER BY 全走索引。
  @@index([ownerId, projectId, threadId, deletedAt, createdAt, id], map: "Generation_media_idx") // getMediaPage: 资产库 keyset 分页（id 是 createdAt 并列的 tiebreak，让 ORDER BY createdAt,id 全走索引）
  @@index([ownerId, projectId, shotId, threadId, deletedAt, createdAt], map: "Generation_candidates_idx") // getCandidates: 候选区（shotId/threadId IS NULL）
  // (shotId, version) 唯一性改由迁移里的 PARTIAL 索引保证（WHERE shotId IS NOT NULL
  //  AND deletedAt IS NULL）——只约束 LIVE 已附着行，让删除后的版本可被复用。Prisma
  //  无法表达条件唯一，故不在此声明 @@unique（旧的非部分索引已在迁移里 DROP）。
  @@index([assetId])
  // G5a: unified library keyset — newest-first over ALL of a project's generations
  // (no threadId filter, unlike Generation_media_idx). Additive, no backfill.
  @@index([ownerId, projectId, deletedAt, createdAt, id], map: "Generation_library_idx")
  // Owner-global Library keyset — newest-first across every project/campaign.
  @@index([ownerId, deletedAt, createdAt, id], map: "Generation_owner_library_idx")
  @@index([ownerId, campaignId, deletedAt])
}

// ComfyUI 模板注册表（SOP v1.1 A3.5 文件版 registry.json 的站内镜像；
// M0 启动时导入，阶段二起成为真相源）
model TemplateBundle {
  id            String    @id
  ownerId       String
  organization Organization @relation(fields: [ownerId], references: [id])
  slug          String
  version       Int
  versionHash   String    @unique // workflow_api.json 原始字节 SHA-256
  displayName   String
  slots         Json // SlotBinding[]（@fikirtive/core）
  // zip 位置永远由哈希推导：bundles/<zipHash>.zip（D14：不存路径）
  zipHash       String    @unique
  modalEndpoint String?
  gpu           String?
  costUsdPerRun Float?
  deprecatedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([slug, version])
  @@index([ownerId, slug])
}

// 剪辑渲染任务（编辑器切片合同的一半；另一半是 @fikirtive/core 的 fikirtiveEdit zod）。
// 三保险第一式：行先于 pg-boss 派发持久化——队列丢失永远不孤儿化一次渲染。
// editJson 在写入前必须过 fikirtiveEdit.parse（web 端校验，worker 端复验）。
enum RenderStatus {
  QUEUED
  RENDERING
  DONE
  FAILED
}

model RenderJob {
  id            String       @id
  ownerId       String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId     String
  editJson      Json
  status        RenderStatus @default(QUEUED)
  /// 0-100，worker 从 ffmpeg -progress 回写
  progress      Int          @default(0)
  /// DONE 时指向产出 MP4 的 Asset（内容寻址，与所有媒体同一套语义）
  outputAssetId String?
  error         String       @default("")
  /// 队列侧关联（codex 审核补全：可审计的重试与对账）
  queueJobId    String       @default("")
  attempts      Int          @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId, createdAt])
  @@index([status, updatedAt]) // 滞留 RENDERING 行的清扫扫描
}

model CaptionJob {
  id            String       @id
  ownerId       String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId     String
  /// the visual-track asset being transcribed (content-addressed) + its hash
  assetId       String
  contentHash   String
  status        RenderStatus @default(QUEUED)
  progress      Int          @default(0)
  error         String       @default("")
  queueJobId    String       @default("")
  attempts      Int          @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId, createdAt])
  @@index([status, updatedAt])
}

/// Cached whisper.cpp transcript, keyed by (contentHash, model). Deterministic
/// for fixed (audio bytes, model, flags) → cache is always valid; a re-render or
/// re-request reuses it for $0 + 0 CPU. cuesJson = CaptionCue[] (the editable seed).
model Transcript {
  id          String   @id
  ownerId     String
  organization Organization @relation(fields: [ownerId], references: [id])
  contentHash String
  model       String
  cuesJson    Json
  createdAt   DateTime @default(now())

  @@unique([contentHash, model])
}

enum GenStatus {
  QUEUED
  GENERATING
  DONE
  FAILED
  CANCELLED
}

// Phase 2 引导式参考图生成（首个收费点）—— 异步任务，镜像 RenderJob 形态。
// 产物=GENERATED 资产 + 挂到实体的 ReferenceImage。条件输入（logo 等）由
// worker 从实体已有 refs 推导，不入此表（D19 信任边界，合同里也无该字段）。
model RefGenJob {
  id             String     @id
  ownerId        String
  organization Organization @relation(fields: [ownerId], references: [id])
  entityId       String
  prompt         String
  model          String     @default("seedream")
  count          Int
  mode           RefGenMode @default(REFSHEET)
  variantId      String? // set when mode = VARIANT; no FK (validated in app before spend)
  status         GenStatus  @default(QUEUED)
  /// 0-100，worker 按已落地图片数回写
  progress       Int        @default(0)
  /// DONE 时产出的 GENERATED 资产（内容寻址，可多张）
  outputAssetIds String[]   @default([])
  /// 钱真相（OPT-6 P3a，纯记录）：付费 provider 调用提交时由 worker 在同一写入里快照
  /// （= REFGEN_PRICE_USD_PER_IMAGE * count）。null = 没扣过费。绝不参与任何 spend 判定。
  spentUsd       Float?
  error          String     @default("")
  queueJobId     String     @default("")
  attempts       Int        @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  // 防双扣靠迁移里的 PARTIAL UNIQUE 索引（active 键唯一，Prisma 无法在 schema 表达条件
  // 唯一，故只在 migration.sql 里建）：同一 (owner, entity, COALESCE(variant,'')) 同时
  // 只能有一个 QUEUED/GENERATING 任务 → 并发同实体提交 DB 层挡住，不会双扣。base/REFSHEET
  // 的 variantId 为 null（COALESCE 成 '' → 同实体串行）；Phase B 的 VARIANT 各带自己的
  // variantId → 不同 variant 并发。startRefGen 捕获 P2002 后复用在途任务（镜像 startGen）。

  @@index([entityId, createdAt])
  @@index([status, updatedAt]) // 滞留 GENERATING 行的清扫扫描
}

enum GenKind {
  IMAGE
  VIDEO
}

// 镜头/会话生成任务（redesign Gen space）—— 产出 Generation 候选，镜像 RefGenJob。
// 条件输入由 worker 从 entityIds 推导（D19）。
model GenJob {
  id                 String    @id
  ownerId            String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId          String
  shotId             String?
  // i2v source = a specific owned Generation's image (Gen space upload→animate)；
  // worker 校验 owner+project 后用它的图做 image-to-video（D19：不收客户端 URL）
  sourceGenerationId String?
  // 可选末帧（last frame）：i2v 在 source→tail 之间补间（Kling tail_image_url）
  tailGenerationId   String?
  referenceVideoGenerationId String?
  prompt             String
  entityIds          String[]  @default([])
  // Phase C: { [entityId]: variantId } — selected variant per @mentioned entity;
  // null/absent = base refs for all mentions (backward-compat with old rows)
  variantSel         Json?
  // 双提交幂等：shot 绑定生成的稳定键（"frame:<shotId>:<slot>" / "animate:<shotId>"）。
  // startGen 命中同键的在途(QUEUED/GENERATING)任务则复用，重载再点不二次扣费。
  idempotencyKey     String?
  // set when a Cowork gen-card initiated this job (no FK — validated in the action). Lets
  // getRecentGenResults keep cowork gens out of the GenSpace hydrate (WHERE threadId IS NULL).
  threadId           String?
  // v1 additive: nullable soft-ref for GenerationBatch grouping (no FK, no backfill)
  batchId            String?
  kind               GenKind   @default(IMAGE)
  /// 无库级默认值(#675,方案 A):这张表同时装图片与视频作业,而默认值只能是其中一种
  /// 引擎。漏写时补一个图片引擎 = 安静地落一条「视频作业写着图片引擎」的行。撤掉之后
  /// 漏写在插入时立刻报错。RefGenJob 的同名列保留默认值 —— 那张表只装图片作业。
  model              String
  count              Int       @default(1)
  /// 视频生成的每模型设置（duration/resolution/aspectRatio/fps/audio）；worker 传给 provider
  videoOptions       Json?
  /// 图片生成的每模型设置（aspectRatio）；worker 传给 provider（#642）。
  /// 入队时冻结的规格快照 —— 它同时是「改这张图 / 再来一张」继承源图画幅的唯一依据。
  /// null = 迁移前的历史行：它们当年产出的就是默认方图，读取端按默认画幅解释。
  imageOptions       Json?
  status             GenStatus @default(QUEUED)
  progress           Int       @default(0)
  /// DONE 时产出的 Generation 行（可多个）
  generationIds      String[]  @default([])
  /// 钱真相：付费 provider 调用是否已返回（扣过费）。DONE=已交付；FAILED+spent=付了但没存上
  ///（可审计/对账，避免"失败=没扣费"的误判）。pre-charge 失败时为 false。
  spent              Boolean   @default(false)
  /// 钱真相（OPT-6 P3a，纯记录）：付费调用提交时 worker 在 commit tx 里快照（video=
  /// videoPriceUsd，image=GEN_PRICE_USD_PER_IMAGE*count），冻结如 Generation.entitySnapshot。
  /// null = 没扣过费。绝不参与任何 spend 判定。
  spentUsd           Float?
  /// #776 生成回执(纯记录):这一单**引擎自报的真实计费量**,按它自己的计量单位,
  /// 在 commit tx 里与 spentUsd 并排冻结 —— 于是「我们按公式估的成本」与「引擎真收的量」
  /// 同一行可比,毛利公式第一次可以反查而不是只能估。
  /// null = 未知,三种情形同一个语义:引擎没报、这一单还没扣过费、或者这一单只有部分产出
  /// 报了量(部分求和会低估成本,比空着更危险)。绝不参与任何 spend 判定。
  /// 内部成本口径,不上商家面。
  billedUnits        Int?
  error              String    @default("")
  queueJobId         String    @default("")
  attempts           Int       @default(0)
  startedAt          DateTime?
  finishedAt         DateTime?
  /// At-most-once Otto verdict claim: set atomically by the worker after gen DONE.
  /// null = not yet claimed; non-null = claimed (or redelivery — skip).
  ottoVerdictAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // 幂等去重靠迁移里的 PARTIAL UNIQUE 索引（active 键唯一，Prisma 无法在 schema 表达
  // 条件唯一，故只在 migration.sql 里建）：同一 (owner, project, idempotencyKey) 同时
  // 只能有一个 QUEUED/GENERATING 任务 → 并发同键提交 DB 层挡住，不会双扣。

  @@index([projectId, createdAt])
  @@index([status, updatedAt])
  @@index([ownerId, status])
}

// 深度研究任务（Otto 研究 S3）：用户在 RESEARCH_CARD 点 Approve → 建此 job + 入队；
// worker 跑有界 search→read→synthesize 循环并经 withLlmBudget 计量。approve 本身 $0
//（不 reserve/settle）—— 花钱只在 worker。幂等靠迁移里的 `research:%` once-EVER 部分唯一
// 索引（Prisma 无法在 schema 表达条件唯一，故只在 migration.sql 里建）：同一 (owner,
// idempotencyKey) 全状态只能有一条 → 双击/重放 approve DB 层挡住,不会双建 job。
model ResearchJob {
  id              String   @id
  ownerId         String
  organization    Organization @relation(fields: [ownerId], references: [id])
  threadId        String
  cardId          String
  idempotencyKey  String
  tier            String
  status          String   @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED（house style：代码校验的 String,非 PG enum）
  /// worker 起步时 withLlmBudget reserve 的 turnBudget 上限（记录用；approve 时为 null）
  reservedCredits Int?
  /// worker settle 的实际 token 成本（记录用；approve 时为 null）
  actualCredits   Int?
  error           String?
  queueJobId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cardId])
}

// ── Auth.js v5 标准模型（D18：邮箱魔法链接）────────────────────────────
// 业务表的 ownerId 仍恒为 "founder"：登录只是门禁，不是多租户（A3 预留不变）。
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Compatibility/display role for Better Auth and older UI. Authorization reads UserRole;
  /// new code must not assume this one string is the user's complete access.
  role          String    @default("viewer")
  activeOrgId   String? // RESERVED NOW (future multi-org switcher; avoids an auth-table migration later)
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[] // NEW: per-org membership (per-tenant RBAC lives here)
  roles         UserRole[]
}

// Platform staff role assignments. A user may hold several sibling roles at once.
// Role → capability mapping lives in packages/core/src/roles.ts.
model UserRole {
  userId     String
  role       String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── Org-as-tenant root (closed-beta foundation P1) ─────────────────────────────
// An Organization IS the tenant. Every business table's existing `ownerId` is an FK
// to Organization.id. The founder org is SEEDED (in the migration) with the literal
// id "founder" so all existing ownerId="founder" rows + R2 keys (u/founder/<hash>)
// are valid with ZERO backfill. New orgs get ULID ids. DORMANT until P3 (the app
// still resolves ownerId via the FOUNDER_OWNER_ID constant).
model Organization {
  id        String    @id // ULID for new orgs; literal "founder" for the seed (== FOUNDER_OWNER_ID). NEVER change.
  name      String    @default("")
  slug      String?   @unique // future tenant routing; nullable now
  deletedAt DateTime? // RESERVED NOW (account closure / GDPR erasure)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  settings  Json?     // owner-scoped preferences (OwnerSettings shape); null = all defaults

  memberships Membership[]
  creditAccount CreditAccount?
  creditLedger  CreditLedger[]

  @@index([deletedAt, createdAt], map: "Organization_list_idx")
  // business back-relations (one per owner-scoped table; required by Prisma):
  projects                Project[]
  entities                Entity[]
  entityVariants          EntityVariant[]
  referenceImages         ReferenceImage[]
  assets                  Asset[]
  assetUnderstandings     AssetUnderstanding[]
  shots                   Shot[]
  shotEntityRefs          ShotEntityRef[]
  generations             Generation[]
  templateBundles         TemplateBundle[]
  renderJobs              RenderJob[]
  captionJobs             CaptionJob[]
  transcripts             Transcript[]
  refGenJobs              RefGenJob[]
  genJobs                 GenJob[]
  actionEvents            ActionEvent[]
  modelDirectives         ModelDirective[]
  modelRegistryOverlays   ModelRegistryOverlay[]
  modelDirectiveRevisions ModelDirectiveRevision[]
  chatThreads             ChatThread[]
  chatMessages            ChatMessage[]
  memories                Memory[]
  generationBatches       GenerationBatch[]
  brandKits               BrandKit[]
  brandRules              BrandRule[]
  brandRecords            BrandRecord[]
  metaConnection          MetaConnection?
  researchJobs            ResearchJob[]
  scheduledPosts          ScheduledPost[]
  // L0 量测原语(六条 back-relation;Seam 5 要求,否则 prisma generate 失败——fail-loud)
  trackedLinks            TrackedLink[]
  qrAssets                QrAsset[]
  qrPlacements            QrPlacement[]
  voucherTokens           VoucherToken[]
  sourceTags              SourceTag[]
  attributionEvents       AttributionEvent[]
  // B0-30: generic multi-channel connection layer (seam 4/5); back-relation required by Prisma.
  channelConnections      ChannelConnection[]
  channelScopes           ChannelScope[]
  // B0-28: share-preview token records (row = authority layer); back-relation required by Prisma.
  sharePreviewTokens      SharePreviewToken[]
  campaigns              Campaign[]
  trendSnapshots          TrendSnapshot[]
  contacts                Contact[]
  contactIdentities       ContactIdentity[]
  consentEvents           ConsentEvent[]
  consentStateProjections ConsentStateProjection[]
  contactDndEvents        ContactDndEvent[]
  providerRefusalEvents   ProviderRefusalEvent[]
  providerRefusalStates   ProviderRefusalState[]
  customerConversations           CustomerConversation[]
  customerMessages                CustomerMessage[]
  customerConversationEvents      CustomerConversationEvent[]
  customerConversationDrafts      CustomerConversationDraft[]
  customerMessageTemplates        CustomerMessageTemplate[]
  customerMessageTemplateVersions CustomerMessageTemplateVersion[]
  segments                Segment[]
  broadcastRuns             BroadcastRun[]
  broadcastAudienceMembers  BroadcastAudienceMember[]
  contactSendFrequencyEvents ContactSendFrequencyEvent[]
  messageDeliveryEvents     MessageDeliveryEvent[]
  messageDeliveryStates     MessageDeliveryState[]
  workflowDefinitions       WorkflowDefinition[]
  workflowRevisions         WorkflowRevision[]
  routines                  Routine[]
  routineRuns               RoutineRun[]
  contactJourneyStates      ContactJourneyState[]
  workflowStepExecutions    WorkflowStepExecution[]
  businessHoursPolicies     BusinessHoursPolicy[]
}

// User <-> Organization join. MembershipRole is the authorization source; the legacy role
// column remains temporarily for old UI/display compatibility.
model Membership {
  id        String    @id // ULID
  userId    String
  orgId     String
  role      String    @default("owner") // compatibility primary role; do not authorize from it alone
  status    String    @default("active") // RESERVED: active|suspended|revoked
  invitedBy String? // RESERVED (future invites)
  deletedAt DateTime? // RESERVED (revocation audit)
  createdAt DateTime  @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  roles MembershipRole[]

  assignedCustomerConversations   CustomerConversation[]           @relation("CustomerConversationAssignee")
  customerMessages                CustomerMessage[]                @relation("CustomerMessageActor")
  customerConversationEvents      CustomerConversationEvent[]      @relation("CustomerConversationEventActor")
  customerConversationEventsFrom  CustomerConversationEvent[]      @relation("CustomerConversationEventFromAssignee")
  customerConversationEventsTo    CustomerConversationEvent[]      @relation("CustomerConversationEventToAssignee")
  customerConversationDrafts      CustomerConversationDraft[]      @relation("CustomerConversationDraftAuthor")
  customerMessageTemplateVersions CustomerMessageTemplateVersion[] @relation("CustomerMessageTemplateVersionAuthor")
  createdBroadcastRuns            BroadcastRun[]                   @relation("BroadcastRunCreatedBy")
  createdWorkflowDefinitions      WorkflowDefinition[]             @relation("WorkflowDefinitionCreatedBy")
  createdWorkflowRevisions        WorkflowRevision[]               @relation("WorkflowRevisionCreatedBy")
  authorizedRoutines              Routine[]                        @relation("RoutineAuthorizedBy")
  killedRoutines                  Routine[]                        @relation("RoutineKilledBy")
  createdRoutines                 Routine[]                        @relation("RoutineCreatedBy")
  createdBusinessHoursPolicies    BusinessHoursPolicy[]            @relation("BusinessHoursPolicyCreatedBy")

  @@unique([userId, orgId])
  // Required by every tenant-qualified Inbox actor/assignee relation.
  @@unique([id, orgId])
  @@index([orgId, role])
  @@index([userId])
}

// Organization-scoped role assignments. Roles are permission bundles and are not a rank;
// one membership can hold creator + approver or any other valid combination.
model MembershipRole {
  membershipId String
  role         String
  assignedAt   DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, role])
  @@index([role])
}

// DB-backed invite allowlist (closed-beta admin P1). email is lowercased at write
// (mirrors the env ALLOWED_EMAILS normalization so comparisons are case-insensitive by convention).
model AllowedEmail {
  email     String   @id // LOWERCASED at write + compare (mirrors env allowlist normalization)
  status    String   @default("invited") // invited | active | revoked
  invitedBy String // operator email (audit)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Credits ledger (closed-beta foundation P2) — the per-org spend cap (M1) ────────
// CreditAccount = hot mutable counters (Int INTERNAL credits, 1 = $0.01); balance can
// never go negative (the reserve is a conditional UPDATE). CreditLedger = append-only
// audit with TWO signed deltas so balance/reserved fully reconstruct from it
// (balance == Σ balanceDelta, reserved == Σ reservedDelta per org). The charge is a
// deterministic pricedCredits value, so reserve == settle (no variable delta). Worker
// writes (RESERVE/SETTLE/REFUND) are exactly-once via a partial-unique (orgId,refId,kind)
// index added in the migration. A future Stripe purchase is one more GRANT row
// (source=PURCHASE) — zero re-migration.
model CreditAccount {
  orgId     String   @id // == Organization.id (== ownerId)
  balance   Int      @default(0) // spendable now (internal credits); never negative
  reserved  Int      @default(0) // held in-flight
  updatedAt DateTime @updatedAt
  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

enum CreditTxnKind {
  GRANT
  RESERVE
  SETTLE
  REFUND
  ADJUST
}

enum CreditTxnSource {
  ADMIN
  BETA
  PROMO
  PURCHASE // reserved for future Stripe
  SYSTEM
}

model CreditLedger {
  id                    String          @id // ULID
  orgId                 String
  balanceDelta          Int // signed Δ to CreditAccount.balance
  reservedDelta         Int // signed Δ to CreditAccount.reserved
  kind                  CreditTxnKind
  source                CreditTxnSource @default(SYSTEM)
  reason                String          @default("")
  refId                 String? // GenJob.id / RefGenJob.id (1:1 with one job/reservation); null for GRANT/ADJUST
  stripePaymentIntentId String? // reserved for future Stripe
  // v1 additive: nullable soft-ref for future agency layer (no FK, no backfill)
  brandId               String?
  idempotencyKey        String // "grant:<uuid>" | "signup:<orgId>" | "stripe:<eventId>" | "reserve:<refId>" etc.
  createdBy             String          @default("")
  createdAt             DateTime        @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, idempotencyKey])
  @@index([orgId, createdAt])
}

// 升级门埋点（D23）：实质动作事件，系统自动记录，3 项目计数门的数据源
model ActionEvent {
  id        String   @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId String?
  type      String // entity.create | entity.update | shot.create | shot.update | generation.attach | bundle.export
  payload   Json?
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([projectId, type])
}

// cowork 知识库（Phase 0B）：per-(model family × generation mode) 的提示词指令，
// 由 founder 在 /admin/directives 实时编辑，无需重新部署。enhancePrompt skill
// 按 (family, mode) 读取并注入（注入是 Phase 1）。directive 为空 → skill 退回
// family-neutral 基础提示词。rules 是闭合结构（Guardian/Coach 读取，避免二次迁移）。
model ModelDirective {
  id         String   @id
  ownerId    String
  organization Organization @relation(fields: [ownerId], references: [id])
  family     String // "seedream" | "kling" | "veo" | "seedance" | "ltx"
  mode       String // "t2i" | "i2i" | "t2v" | "i2v" | "i2v-tail"
  directive  String   @default("") // the injectable snippet; "" → family-neutral base
  rules      Json? // closed shape: { maxConcurrentMotions?, noTagCommas?, i2vMotionNotScene?, pitfalls?[] }
  notes      String   @default("") // founder's rationale / source
  confidence String   @default("untested") // "high" | "medium" | "low" | "untested"
  enabled    Boolean  @default(true) // off → skill ignores it (family-neutral base)
  source     String   @default("research") // "research" | "founder" | "vision-v2"
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  revisions ModelDirectiveRevision[]

  @@unique([id, ownerId])
  @@unique([ownerId, family, mode]) // the lookup key; one directive per cell
  @@index([ownerId, family])
}

/// 运行时配置（OPT-6 P1a）：把散在 env 的开关变成 DB 旋钮（vision caps / COWORK_PROVIDER）。
/// key 是代码侧固定枚举；valueJson 由 per-key zod 在读/写两侧校验。读取走 read-through，
/// DB 无值回退 env（见 apps/web/lib/runtime-config.ts）。免重新部署即生效（不缓存）。
model RuntimeConfig {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
  updatedBy String   @default("")
}

/// 模型注册表覆盖层（OPT-6 P2）：能力真相 100% 在 typed catalog（GEN_MODELS /
/// GEN_VIDEO_MODELS / REFGEN_MODELS）；本表只承载 disable 布尔 + advisory notes。
/// 一行永远不能新增模型或放宽上限，只能与 typed menu 交集收窄（停掉一个已有模型）。
/// 校验：modelId 在写入时校验 ∈ 三个 catalog 的并集；未知行在读取侧忽略。
/// 强制点见 startGen / startRefGen / dispatchVariantJob / worker handleGen+handleRefGen。
/// 注意 seedream 耦合：GEN_MODELS=REFGEN_MODELS=["seedream"]，停 seedream = 停所有图像生成。
model ModelRegistryOverlay {
  id        String   @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  modelId   String
  enabled   Boolean  @default(true)
  notes     String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([ownerId, modelId])
}

// 指令编辑历史（R6）：每次 save 写一行快照，用于回滚（比 ActionEvent 更结构化）。
model ModelDirectiveRevision {
  id          String   @id
  directiveId String
  ownerId     String
  organization Organization @relation(fields: [ownerId], references: [id])
  directive   String
  rules       Json?
  confidence  String
  enabled     Boolean
  source      String
  editedBy    String   @default("") // the admin email at save time
  createdAt   DateTime @default(now())

  parent ModelDirective @relation(fields: [directiveId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@index([directiveId, createdAt])
}

// ── Cowork agent loop (SP1) ─────────────────────────────────────────────────
enum ChatRole {
  USER
  AGENT
}

enum ChatMessageKind {
  TEXT
  PLAN
  GEN_CARD
  GEN_RESULT
  DENIAL
  TURN_ERROR
  ACTION_CARD
  BUILD_CARD
  STORYBOARD_CARD
  RESEARCH_CARD
  RESEARCH_REPORT
  PERFORMANCE_CARD
  APPROVAL_CARD
  CAMPAIGN_CARD
}

// G7: per-org autonomy mode for Otto's ad-write operations
enum AdsAutonomy {
  ASK
  AUTO
}

model ChatThread {
  id        String        @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId String
  title     String        @default("")
  // cowork: reserved — folded older-turns summary (generation logic deferred until long sessions).
  rollingSummary String?
  // otto: serialized RunState (JSON string) for multi-turn continuation. Nullable — existing threads have none.
  ottoState String?
  // #879 step 1: schema pinning for the Otto foundation redesign — nullable, unwritten this
  // round. Semantics land in #879 step 2 (context assembler). See ChatMessage below for the
  // per-column meaning; these mirror them at the thread level.
  surface    String?
  subjectRef String?
  actorId    String?
  visibility String?
  outletId   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  pinnedAt  DateTime?
  deletedAt DateTime?
  messages  ChatMessage[]

  // thread list: a PARTIAL index ON (projectId, ownerId, updatedAt) WHERE deletedAt IS NULL
  // lives in migration.sql (Prisma can't express the WHERE). The full @@index is intentionally
  // omitted — the partial covers every live-thread read; deleted threads are never listed.
  @@unique([id, ownerId])
  @@index([ownerId, pinnedAt, updatedAt], map: "ChatThread_owner_pinned_idx")
}

model ChatMessage {
  id                 String          @id
  threadId           String
  ownerId            String
  organization Organization @relation(fields: [ownerId], references: [id])
  role               ChatRole
  kind               ChatMessageKind
  seq                Int
  text               String          @default("")
  payload            Json?
  genJobId           String?
  sourceGenerationId String?
  replyToMessageId   String?
  // #879 step 1 — Otto foundation schema pinning (issue #879, Founder-approved plan A,
  // self-built foundation). Five nullable columns pinned NOW, before public sign-up makes
  // backfilling every historical row impossible; semantics land in #879 step 2. Client-declarable
  // (position-only): surface (which product surface the turn came from), subjectRef (the
  // record/entity the turn was about), outletId (which outlet/channel context). Server-only
  // (identity — NEVER client input): actorId, visibility — left null this round; will be filled
  // from the authenticated principal once #879 step 2 defines their semantics.
  surface    String?
  subjectRef String?
  actorId    String?
  visibility String?
  outletId   String?
  createdAt          DateTime        @default(now())
  deletedAt          DateTime?

  thread ChatThread @relation(fields: [threadId, ownerId], references: [id, ownerId], onDelete: Restrict)

  @@index([threadId, seq])
}

// ── v1 additive: brand memory + generation batch ──────────────────────────────

// Brand-memory notes: editable owner-scoped notes (voice, product facts, etc.)
// that Otto reads as context. brandId is nullable — null = not yet scoped to an
// agency brand (v1 ships with brandId=null; the agency layer adds scoping via the
// existing column, no future migration needed).
model Memory {
  id        String    @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  brandId   String?
  category  String
  content   String
  source    String    // 'otto' | 'user'
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId, brandId, deletedAt])
}

// Brand Record: living brand collections (products / customer segments / offers) for the marketing agent.
// kind/status/source are code-validated Strings, NOT PG enums (house style).
model BrandRecord {
  id           String    @id
  ownerId      String
  organization Organization @relation(fields: [ownerId], references: [id])
  brandId      String?
  kind         String    // 'product' | 'segment' | 'offer' (code-validated, not a PG enum — house style)
  nameKey      String    // normalized name/title — upsert key (see @fikirtive/core brand-records)
  data         Json      // zod-validated per-kind payload; offer dates live in the columns below, NOT here
  status       String    @default("active") // 'active' | 'archived'
  startsAt     DateTime? // offers only
  endsAt       DateTime? // offers only — drives read-time expiry (never a background job)
  source       String    // 'otto' | 'user' (last author, same semantics as Memory.source)
  pinned       Boolean   @default(false)   // products: featured-first injection
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // A raw partial UNIQUE INDEX on (ownerId, COALESCE(brandId,''), kind, nameKey) WHERE deletedAt IS NULL
  // lives in the accompanying migration (same pattern as BrandKit F5) — Prisma can't model partial indexes.
  @@index([ownerId, brandId, kind, deletedAt])
}

// Brand Kit: structured brand metadata (colors, fonts, tone, style guide, logo) per owner/brand.
// brandId is nullable — null = not yet scoped to an agency brand (mirrors Memory.brandId convention).
model BrandKit {
  id            String    @id
  ownerId       String
  organization  Organization @relation(fields: [ownerId], references: [id])
  brandId       String?
  name          String?
  colorsJson    Json?     // { primary, secondary, accent, … } freeform JSON
  fonts         String[]  // e.g. ["Inter", "Playfair Display"]
  tone          String?   // e.g. "warm, conversational, approachable"
  styleGuide    String?   // free-text style notes
  logoAssetId   String?   // FK to Asset.id (optional, not enforced — asset may be deleted)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // F5: a raw UNIQUE INDEX on (ownerId, COALESCE(brandId,'')) lives in migration
  // 20260628120000_review_fixes_indexes — dedups kits per owner+brand incl. brandId IS NULL.
  @@index([ownerId, brandId])
}

// Brand Rule: explicit always/never/tone/color constraints for Otto to follow.
// kind ∈ { "always" | "never" | "tone" | "color" }
model BrandRule {
  id           String    @id
  ownerId      String
  organization Organization @relation(fields: [ownerId], references: [id])
  brandId      String?
  kind         String    // "always" | "never" | "tone" | "color"
  text         String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@index([ownerId, brandId, active])
}

// Generation batch: groups multiple GenJob outputs into a single "batch" proposal
// (the ad-pack grouping table). projectId is nullable — batches can be cross-project.
model GenerationBatch {
  id        String    @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  projectId String?
  name      String
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId, projectId, deletedAt])
}

// --- Better Auth (dormant foundation) — own tables, no collision with NextAuth's User/Account/Session/VerificationToken ---
model BetterAuthUser {
  id            String              @id
  name          String
  email         String              @unique
  emailVerified Boolean             @default(false)
  image         String?
  // Better Auth admin plugin fields (default field names — no `schema` override needed).
  role          String?             // BA gate role; MIRROR of canonical User.role (Phase 2). Unused in Phase 1.
  banned        Boolean?            @default(false) // session.create.before hook blocks login when true
  banReason     String?
  banExpires    DateTime?           // plugin auto-clears an expired ban in the session hook
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  sessions      BetterAuthSession[]
  accounts      BetterAuthAccount[]
  @@map("ba_user")
}
model BetterAuthSession {
  id        String         @id
  expiresAt DateTime
  token     String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  ipAddress String?
  userAgent String?
  impersonatedBy String?   // admin's BA user id on an impersonation session (Phase 2). Added now to keep one migration.
  userId    String
  user      BetterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("ba_session")
}
model BetterAuthAccount {
  id                    String         @id
  accountId             String
  providerId            String
  userId                String
  user                  BetterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  @@index([userId])
  @@map("ba_account")
}
model BetterAuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
  @@map("ba_verification")
}

/// #795 —— Better Auth 自己的限流台账。
///
/// 它此前跑在**进程内存**里。开第二个实例的那一刻,每个实例各有一份计数,同一个 IP 的
/// 预算就凭空翻倍;每次部署重启又把计数清零。也就是说:闸门看起来在,数字是假的。
/// 挪到这张表之后,几个实例共用同一份计数,重启不清零。
///
/// 形状由 Better Auth 定(key/count/lastRequest,lastRequest 是 epoch 毫秒的 bigint),
/// 我们只负责让它落在自己的表里。**不要**把它和 RateLimitCounter 合并:那张是我们自己
/// 那几道闸的表,两边的算法与语义不同,合表等于把两套规则绑在一次 schema 变更上。
model BetterAuthRateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
  @@map("ba_rate_limit")
}

/// #795 —— 我们自己那几道闸的跨实例计数器(登录链接门、密码门、生成、上传、外链)。
///
/// 固定窗口:一个 key 一行,`count` 是本窗口内已经**放行**过多少次,`expiresAt` 是本窗口
/// 什么时候结束(epoch 毫秒)。用 bigint 存毫秒而不是 timestamp,是为了让比较是纯整数运算
/// —— 时区、精度、会话 TZ 这些东西一个都不必参与判断「还有没有额度」。
///
/// 被拒的一次**不加计数**(见 rate-limit.ts):这是 #757 已经买过一次教训的性质 —— 让拒绝
/// 也推窗口,窗口就永远不结束,一个人的重试循环会把同一出口后面所有人一起锁死。
model RateLimitCounter {
  key       String @id
  count     Int
  expiresAt BigInt
  @@index([expiresAt])
  @@map("rate_limit_counter")
}

model CanvasNode {
  id           String    @id
  ownerId      String
  projectId    String
  type         String    // "image" | "video" | "text"
  x            Float
  y            Float
  w            Float
  h            Float
  text         String?
  prompt       String?
  generationId String?
  genJobId     String?
  // 有限、互斥的取值集,由 CanvasNode_status_check 落库强制(#602 T3 · spec #599 D4):
  // pending | done | failed | cancelled | timeout | missing | deleted | unknown。
  // 词表与写入者的唯一权威在 apps/web/lib/canvas-card-status.ts;'unknown' 没有写入者,
  // 它只是迁移给历史越集值准备的落脚点。卡面(queued/generating/…)是**推导**出来的,不入库。
  status       String    @default("done")
  // 一列三义的旧「来源」列(#603 T4 · spec #599 D5)。它同时装过「真派生」「同批锚点」
  // 「假兄弟血缘」三件事,所以任何读它的人都只能猜。下面四列把这三件事拆开落盘;这一列
  // 自 T4 起**无写入者、无读取者**,只为迁移回填留作证据。删列另开一片(见 migration 说明)。
  sourceNodeId String?
  // ── 批次身份:服务端在结算那一刻就掌握的事实,不再由坐标或幸存卡数推回 ──
  /// 这张卡在该付费作业产出列表里的位置(0 起)。null = 不知道(无作业/未绑定产出/老行)。
  batchIndex   Int?
  /// 该付费作业一共产出几张(不是「现在还剩几张」)。null = 不知道。
  batchSize    Int?
  /// 布局锚点:这张卡是围着哪张同批卡摆的。**只管摆放,永不定义血缘**。
  layoutAnchorNodeId String?
  /// 真派生:这张卡的付费作业是以哪张卡的产出为输入的(GenJob.sourceGenerationId 的卡)。
  /// 唯一的连线依据。null = 没有派生,或来历不详 —— 两者都画不出线,这正是诚实的做法。
  madeFromNodeId     String?
  // G4c: convo attribution — which ChatThread created this node. Nullable, no backfill;
  // validated (same owner+project) in createCanvasNode, no FK. null = "unattributed".
  threadId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([ownerId, projectId])
  @@index([ownerId, projectId, threadId])
}

// G6a: a user's connected Meta (Facebook) Ads account. One per owner. The access token is
// AES-256-GCM encrypted at rest (apps/web/lib/token-encryption.ts) and never leaves the server.
model MetaConnection {
  id             String       @id
  ownerId        String       @unique
  // onDelete: Cascade matches the FK 20260628140000_meta_connection created; without it
  // Prisma defaults to Restrict and `migrate dev` keeps trying to recreate the constraint.
  organization   Organization @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  metaUserId     String?
  accessTokenEnc String       // encrypted; never plaintext, never sent to the client
  tokenExpiresAt DateTime?
  scope          String       // "ads_read"
  status         String       @default("active") // "active" | "expired"
  adsAutonomy    AdsAutonomy  @default(ASK)      // per-org Ask/Auto; lost on disconnect → resets to ASK
  adsWritesPaused Boolean     @default(false)    // kill-switch: when true, executor refuses all writes
  organicPublishPaused Boolean @default(false)   // L1 kill-switch (mirrors adsWritesPaused): true ⇒ publish worker refuses all organic publishes
  canWrite       Boolean      @default(false)    // true only if Meta actually granted ads_management
  canManagePages Boolean      @default(false)    // true if Meta granted pages_manage_ads / pages_read_engagement
  canPublish     Boolean      @default(false)    // L1: true only if Meta actually granted instagram_content_publish + pages_manage_posts (App-Review gated; fail-closed until then)
  defaultPageId  String?                         // FB Page the org wants to post to by default
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// R-010 D9 M1: provider-neutral stable channel-instance identity authority. Phase 1 is deliberately
// lifecycle-free: no status, TTL, issuer epoch, recycle, quarantine, revive, or auto-merge fields.
model ChannelScope {
  id           String   @id
  ownerId      String
  organization Organization @relation(fields: [ownerId], references: [id])
  channel      String
  scopeKey     String
  createdAt    DateTime @default(now())

  channelConnections ChannelConnection[]
  contactIdentities  ContactIdentity[]
  customerMessageTemplates CustomerMessageTemplate[]
  broadcastRuns      BroadcastRun[]
  messageDeliveryEvents MessageDeliveryEvent[]

  @@unique([ownerId, channel, scopeKey])
  // Required by the composite references below so they cannot cross owner or channel boundaries.
  @@unique([id, ownerId, channel])
}

// B0-30: generic channel-connection schema (harmony-01 §三 #5; MASTERPLAN P1½-2). The future home
// for ANY publish channel — Meta migrates in when convenient; a new channel = a new adapter, no core
// change. `kind` is an OPEN string (house style, NOT a closed enum) so adding "x"/"tiktok"/"linkedin"
// needs no migration. Crypto discipline mirrors MetaConnection: accessTokenEnc is AES-256-GCM
// ciphertext (packages/token-crypto), never plaintext, never sent to the client. Owner-scoped
// (宪法 6 铁幕): every query filters ownerId — registered in TENANT_MODELS (packages/db/src/tenant-guard.ts).
model ChannelConnection {
  id             String       @id
  ownerId        String
  organization   Organization @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind           String       // OPEN string: "instagram" | "facebook" | "x" | … (new channel ⇒ no migration)
  channelScopeId String?
  channelScope   ChannelScope? @relation(fields: [channelScopeId, ownerId, kind], references: [id, ownerId, channel], onDelete: Restrict)
  externalId     String?      // channel-side account/page id (e.g. IG business id, X user id)
  displayName    String?      // human label for the connected account
  accessTokenEnc String       // AES-256-GCM ciphertext; never plaintext, never sent to the client
  tokenExpiresAt DateTime?
  scope          String       @default("")
  status         String       @default("active") // "active" | "expired"
  // Per-channel organic-publish kill-switch (B4 spec 契约3 / freeze rider R5), the ChannelConnection
  // analogue of MetaConnection.organicPublishPaused: a deliberate operator pause, ORTHOGONAL to
  // status/expiry. DEFAULT false; the X publish gate fail-closes (refuses, zero external calls) when true.
  publishPaused  Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // At most one connection per (owner, channel, external account). A NULL externalId = the single
  // "default" connection for that (owner, kind) before an account id is bound. Postgres UNIQUE
  // treats NULLs as distinct, so this three-column unique alone CANNOT enforce that singleton —
  // a raw partial UNIQUE INDEX ChannelConnection_one_default_per_owner_kind on (ownerId, kind)
  // WHERE externalId IS NULL lives in the accompanying migration (repo idiom, same as
  // PublishAttempt_one_applying_per_post: Prisma can't model a partial index, so not declared here).
  providerRefusalEvents ProviderRefusalEvent[]
  messageDeliveryEvents MessageDeliveryEvent[]
  workflowStepExecutions WorkflowStepExecution[]

  @@unique([ownerId, kind, externalId])
  // Required by tenant-qualified ProviderRefusalEvent references.
  @@unique([id, ownerId])
  // C7-M1: additive candidate key for an exact tenant/channel connection bind.
  @@unique([id, ownerId, kind])
  @@index([ownerId])
}

// B0-28: share-preview token record (B4 block spec §2.2 "内部写一行 token 记录" — the ROW is the
// AUTHORITY layer; the HMAC token is only the TRANSPORT layer). One row per mint; revocable
// (revokedAt); verify = HMAC valid ∧ row live (present, unrevoked, unexpired). tokenDigest stores
// SHA-256(token) — never the token itself — so a DB leak cannot mint working links. Owner-scoped
// (宪法 6): registered in TENANT_MODELS.
model SharePreviewToken {
  id              String        @id
  ownerId         String
  organization    Organization  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  scheduledPostId String
  post            ScheduledPost @relation(fields: [scheduledPostId, ownerId], references: [id, ownerId], onDelete: Cascade)
  tokenDigest     String        @unique // sha256 hex of the signed token (lookup key at verify time)
  expiresAt       DateTime
  revokedAt       DateTime?     // set by revokeSharePreview — a revoked row fails verify (fail-closed)
  createdAt       DateTime      @default(now())

  @@index([ownerId, scheduledPostId])
}

// B0-103: cold-start posting-time seed (GRILL-VERDICTS:157; A/S 区 composer suggestion).
// STATIC, GLOBAL, READ-ONLY craft knowledge — the best windows to post per channel, seeded once so
// the composer can suggest good times BEFORE a user has any history of their own. Deliberately NOT
// owner-scoped (no ownerId): it is the same knowledge for everyone, like a template, so it never
// enters the tenant iron-curtain. Otto reads it via the suggestPostTimes skill (free/read/internal).
model PostingTimeSeed {
  id        String @id
  channel   String // "instagram" | "facebook" | … (matches ChannelConnection.kind / SCHEDULE_CHANNELS vocabulary)
  dayOfWeek Int    // 0=Sunday … 6=Saturday (UTC)
  hourUtc   Int    // 0–23, the slot's start hour in UTC
  score     Int    // relative slot strength (higher = better) for ranking
  rationale String @default("") // short human note, e.g. "evening scroll peak"

  @@unique([channel, dayOfWeek, hourUtc])
  @@index([channel])
}

// G7: idempotency table for Otto ad-write steps. One row per (owner, card, step).
model MetaActionExecution {
  id           String   @id
  ownerId      String
  cardId       String
  stepIndex    Int
  status       String   // PENDING | APPLYING | APPLIED | FAILED
  appliedValue Json?
  createdAt    DateTime @default(now())

  // Exactly-once safety index for ad-write steps, created as raw SQL in
  // 20260628150000_g7_ad_write. That migration's comment calls it "partial-unique",
  // but it has no WHERE clause — it's a plain unique index, so it IS expressible
  // here. Modeled so `migrate dev` stops trying to DROP it as drift.
  @@unique([ownerId, cardId, stepIndex], map: "MetaActionExecution_step_once")
}

// Block S1 (Otto research): Nous-style page cache. `fetchAndExtract`'s clean page text
// is cached once by urlHash, then read page-by-page on demand (readPageCached in
// apps/web/lib/web-page-cache.ts). Additive, no FK, no owner scope: it caches PUBLIC web
// pages (SSRF-guarded at fetch time), not tenant data, so a URL fetched by one org can be
// served from cache to another — same public bytes. $0 infra table; money path untouched.
model WebPageCache {
  id        String   @id
  urlHash   String   @unique
  url       String
  title     String   @default("")
  text      String
  fetchedAt DateTime
}

// ── B8 一期: Campaign + CRM 最薄数据层 (2026-07-14 frozen spec) ─────────────
// All five models are owner-scoped by birth (Seam 5): ownerId has no default,
// Organization owns the back-relation, TENANT_MODELS guards list writes/reads,
// and each hot index begins with ownerId and includes deletedAt.
model Campaign {
  id        String   @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  name      String
  status    String   @default("DRAFT") // DRAFT | ACTIVE | DONE | CANCELLED (code-validated)
  goal      String
  startAt   DateTime
  endAt     DateTime
  utmBase   String?
  planJson  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  generations       Generation[]
  scheduledPosts    ScheduledPost[]
  trendSnapshots    TrendSnapshot[]
  firstTouchContacts Contact[] @relation("ContactFirstTouchCampaign")
  broadcastRuns     BroadcastRun[]

  // C5-M1: additive-only, required by BroadcastRun's composite tenant FK (same pattern as
  // PR #375's Membership @@unique([id, orgId])). No existing column/behavior changes.
  @@unique([id, ownerId])
  @@index([ownerId, status, deletedAt])
}

model TrendSnapshot {
  id         String   @id
  ownerId    String
  organization Organization @relation(fields: [ownerId], references: [id])
  summary    String
  sources    Json
  capturedAt DateTime
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId, ownerId], references: [id, ownerId], onDelete: Restrict)
  createdAt  DateTime @default(now())
  deletedAt  DateTime?

  @@index([ownerId, capturedAt, deletedAt])
}

model Contact {
  id                   String   @id
  ownerId              String
  organization         Organization @relation(fields: [ownerId], references: [id])
  name                 String
  lifecycleStage       String   @default("New") // New | Active | Dormant (code-validated)
  source               String
  firstTouchCampaignId String?
  firstTouchCampaign   Campaign? @relation("ContactFirstTouchCampaign", fields: [firstTouchCampaignId, ownerId], references: [id, ownerId], onDelete: Restrict)
  firstTouchAt         DateTime
  lastSeenAt           DateTime
  marketingConsent     String   @default("unknown") // opt_in | opt_out | unknown (code-validated)
  consentSource        String?
  consentAt            DateTime?
  doNotDisturb         Boolean  @default(false)
  totalOrdersMyr       Decimal? @db.Decimal(14, 2)
  createdAt            DateTime @default(now())
  deletedAt            DateTime?

  identities              ContactIdentity[]
  consentEvents            ConsentEvent[]
  consentStateProjections  ConsentStateProjection[]
  dndEvents                ContactDndEvent[]
  broadcastAudienceMembers BroadcastAudienceMember[]
  sendFrequencyEvents      ContactSendFrequencyEvent[]
  journeyStates            ContactJourneyState[]
  workflowStepExecutions   WorkflowStepExecution[]

  // Required by tenant-qualified consent and DND references.
  @@unique([id, ownerId])
  @@index([ownerId, lifecycleStage, deletedAt])
}

model ContactIdentity {
  id           String   @id
  ownerId      String
  organization Organization @relation(fields: [ownerId], references: [id])
  contactId    String
  contact        Contact       @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Restrict)
  channelScopeId String?
  channelScope   ChannelScope? @relation(fields: [channelScopeId, ownerId, channel], references: [id, ownerId, channel], onDelete: Restrict)
  channel        String
  externalId     String
  handle         String?
  label          String?
  // #803 — credibility grade, enforced by a CHECK constraint in
  // 20260809100000_contact_identity_verification_grade (Prisma cannot express the closed set
  // or the evidence pairing). 'merchant_unverified' = the merchant typed it; 'channel_verified'
  // = a connected channel confirmed it, and then verifiedAt/verifiedSourceKind say when and by
  // what. The two are NOT interchangeable: only channel_verified rows are audience/send
  // material (see contactChannelFacts / the broadcast's send targets).
  // The defaults are self-consistent on purpose (see the migration): the evidence CHECK is
  // strict in both directions, so a row that names no grade at all still has to be a legal one.
  verificationStatus String    @default("channel_verified")
  verifiedAt         DateTime? @default(now())
  verifiedSourceKind String?   @default("channel_record")
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  // Identity uniqueness is a PARTIAL unique index (live rows only) added in
  // 20260714100000_b8_phase1_campaign_crm/migration.sql (Prisma can't express conditional uniqueness).
  // R-010 §7 M1 expand-only nuance: channelScopeId is nullable so legacy rows remain untouched.
  // Although M1 names the eventual active four-fact unique, the next sentence forbids enabling its
  // writer/index before verified backfill and atomic cutover. PostgreSQL cannot create a dormant
  // enforcing unique index, so this base migration deliberately leaves that later index absent and
  // preserves the existing legacy three-fact partial unique unchanged; reader/writer behavior stays put.
  providerRefusalEvents ProviderRefusalEvent[]
  customerConversations CustomerConversation[]
  broadcastAudienceMembers BroadcastAudienceMember[]
  journeyStates ContactJourneyState[]
  workflowStepExecutions WorkflowStepExecution[]

  // Required by tenant-qualified ProviderRefusalEvent references.
  @@unique([id, ownerId])
  // C5-M1 P2-1 (review-driven, additive): binds an identity to its owning contact so
  // BroadcastAudienceMember's triple FK can reject a contactId/contactIdentityId mismatch at
  // the DB layer — a writer bug pairing contact A with contact B's identity is now impossible,
  // not just unvalidated.
  @@unique([id, contactId, ownerId])
  // C7-M1: additive candidate key for a contact-bound identity on an exact channel.
  @@unique([id, contactId, ownerId, channel])
  @@index([ownerId, contactId, deletedAt])
}

// C4b-M1: provider-neutral Customer Inbox storage only. All closed taxonomies remain
// code-validated Strings; no writer, provider adapter, send path, or delivery authority exists here.
model CustomerConversation {
  id                   String          @id
  ownerId              String
  organization         Organization    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  contactIdentityId    String
  contactIdentity      ContactIdentity @relation(fields: [contactIdentityId, ownerId], references: [id, ownerId], onDelete: Restrict)
  status               String
  assigneeMembershipId String?
  assigneeMembership   Membership?     @relation("CustomerConversationAssignee", fields: [assigneeMembershipId, ownerId], references: [id, orgId], onDelete: Restrict)
  automationState      String          @default("disabled")
  revision             Int             @default(0)
  lastMessageAt        DateTime?
  lastActivityAt       DateTime
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  messages CustomerMessage[]
  events   CustomerConversationEvent[]
  draft    CustomerConversationDraft?

  @@unique([id, ownerId])
  @@unique([ownerId, contactIdentityId])
  @@index([ownerId, status, lastActivityAt, id], map: "CustomerConversation_owner_status_activity_idx")
  @@index([ownerId, assigneeMembershipId, status, lastActivityAt, id], map: "CustomerConversation_owner_assignee_status_activity_idx")
}

model CustomerMessage {
  id                      String               @id
  ownerId                 String
  organization            Organization         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  conversationId          String
  conversation            CustomerConversation @relation(fields: [conversationId, ownerId], references: [id, ownerId], onDelete: Restrict)
  direction               String
  actorKind               String
  actorMembershipId       String?
  actorMembership         Membership?          @relation("CustomerMessageActor", fields: [actorMembershipId, ownerId], references: [id, orgId], onDelete: Restrict)
  kind                    String
  contentJson             Json
  searchText              String
  contentHash             String
  // Raw unique index CustomerMessage_owner_source_event_live lives in migration
  // 20260720160000_c4b_m1_inbox_storage because Prisma cannot model its partial predicate.
  sourceEventKey          String?
  sourcePayloadHash       String?
  canonicalizationVersion String
  externalMessageRef      String?
  occurredAt              DateTime?            @db.Timestamptz(6)
  receivedAt              DateTime             @db.Timestamptz(6)
  createdAt               DateTime             @default(now())

  @@index([ownerId, conversationId, receivedAt, id], map: "CustomerMessage_owner_conversation_received_idx")
}

model CustomerConversationEvent {
  id                       String               @id
  ownerId                  String
  organization             Organization         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  conversationId           String
  conversation             CustomerConversation @relation(fields: [conversationId, ownerId], references: [id, ownerId], onDelete: Restrict)
  revision                 Int
  kind                     String
  actorKind                String
  actorMembershipId        String?
  actorMembership          Membership?          @relation("CustomerConversationEventActor", fields: [actorMembershipId, ownerId], references: [id, orgId], onDelete: Restrict)
  fromAssigneeMembershipId String?
  fromAssigneeMembership   Membership?          @relation("CustomerConversationEventFromAssignee", fields: [fromAssigneeMembershipId, ownerId], references: [id, orgId], onDelete: Restrict, map: "CustomerConversationEvent_fromAssignee_ownerId_fkey")
  toAssigneeMembershipId   String?
  toAssigneeMembership     Membership?          @relation("CustomerConversationEventToAssignee", fields: [toAssigneeMembershipId, ownerId], references: [id, orgId], onDelete: Restrict, map: "CustomerConversationEvent_toAssignee_ownerId_fkey")
  fromAutomationState      String?
  toAutomationState        String?
  note                     String?
  idempotencyKey           String
  createdAt                DateTime             @default(now())

  @@unique([ownerId, idempotencyKey])
  @@unique([ownerId, conversationId, revision], map: "CustomerConversationEvent_owner_conversation_revision_key")
  @@index([ownerId, conversationId, createdAt, id], map: "CustomerConversationEvent_owner_conversation_created_idx")
}

model CustomerConversationDraft {
  ownerId              String
  organization         Organization         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  conversationId       String
  conversation         CustomerConversation @relation(fields: [conversationId, ownerId], references: [id, ownerId], onDelete: Restrict)
  revision             Int                  @default(0)
  conversationRevision Int
  authorKind           String
  authorMembershipId   String?
  authorMembership     Membership?          @relation("CustomerConversationDraftAuthor", fields: [authorMembershipId, ownerId], references: [id, orgId], onDelete: Restrict)
  contentJson          Json
  contentHash          String
  updatedAt            DateTime             @updatedAt

  @@id([ownerId, conversationId])
  // Same one-current-draft identity in relation-field order, required by Prisma's 1:1 relation.
  @@unique([conversationId, ownerId])
}

model CustomerMessageTemplate {
  id             String       @id
  ownerId        String
  organization   Organization @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  channelScopeId String
  channel        String
  channelScope   ChannelScope @relation(fields: [channelScopeId, ownerId, channel], references: [id, ownerId, channel], onDelete: Restrict)
  name           String
  locale         String
  createdAt      DateTime     @default(now())
  // Raw unique index CustomerMessageTemplate_owner_scope_name_locale_live lives in migration
  // 20260720160000_c4b_m1_inbox_storage because Prisma cannot model its partial predicate.
  archivedAt     DateTime?

  versions CustomerMessageTemplateVersion[]

  @@unique([id, ownerId])
  @@index([ownerId, channelScopeId, archivedAt, name], map: "CustomerMessageTemplate_owner_scope_archived_name_idx")
}

model CustomerMessageTemplateVersion {
  id                    String                  @id
  ownerId               String
  organization          Organization            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  templateId            String
  template              CustomerMessageTemplate @relation(fields: [templateId, ownerId], references: [id, ownerId], onDelete: Restrict)
  revision              Int
  purposeClass          String
  category               String
  definitionJson        Json
  contentHash           String
  submissionState       String                  @default("draft")
  reviewState           String                  @default("not_submitted")
  availabilityState     String                  @default("unavailable")
  reviewRevision        Int                     @default(0)
  externalTemplateRef   String?
  frozenAt              DateTime?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  createdByMembershipId String
  createdByMembership   Membership              @relation("CustomerMessageTemplateVersionAuthor", fields: [createdByMembershipId, ownerId], references: [id, orgId], onDelete: Restrict, map: "CustomerMessageTemplateVersion_createdByMember_ownerId_fkey")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  broadcastRuns BroadcastRun[]

  @@unique([id, ownerId])
  @@unique([ownerId, templateId, revision], map: "CustomerMessageTemplateVersion_owner_template_revision_key")
  @@index([ownerId, templateId, revision], map: "CustomerMessageTemplateVersion_owner_template_revision_idx")
}

// R-010 M1 consent batch: append-only permission facts. Closed taxonomies stay code-validated
// Strings (the current CRM house style); this migration adds storage only and switches no behavior.
model ConsentEvent {
  id             String       @id
  ownerId        String
  organization   Organization @relation(fields: [ownerId], references: [id])
  contactId      String
  contact        Contact      @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Restrict)
  channel        String // provider-neutral closed taxonomy (code-validated)
  purpose        String // marketing | transactional | review_request (code-validated)
  action         String // grant | revoke (code-validated)
  actorKind      String // customer | merchant | legacy_unknown; system is forbidden (code-validated)
  entryMode      String // interactive | backfill (code-validated)
  sourceKind     String // R-010 §4.3 endpoint-bound closed set (code-validated)
  evidenceStatus String // verified | asserted | unresolved (code-validated)
  evidenceRef    String? // opaque reference only; never raw message/provider payload
  operationId    String
  idempotencyKey String
  occurredAt     DateTime?    @db.Timestamptz(6)
  receivedAt     DateTime     @db.Timestamptz(6)
  createdAt      DateTime     @default(now())

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, contactId, channel, purpose, receivedAt, id])
}

// Rebuildable cache derived from ConsentEvent; it is not an independent authority or mutation API.
model ConsentStateProjection {
  ownerId         String
  organization    Organization @relation(fields: [ownerId], references: [id])
  contactId       String
  contact         Contact      @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Restrict)
  channel         String
  purpose         String
  state           String // unknown | verified_grant | effective_revoke (code-validated)
  lastEventId     String
  lastReceivedAt  DateTime     @db.Timestamptz(6)
  stateActorKind  String
  stateSourceKind String
  evidenceStatus  String
  updatedAt       DateTime     @updatedAt

  @@unique([ownerId, contactId, channel, purpose])
}

// Append-only Contact-wide DND facts. The shared writer/fold and doNotDisturb projection switch
// are deliberately deferred; this migration only creates their future authority carrier.
model ContactDndEvent {
  id             String       @id
  ownerId        String
  organization   Organization @relation(fields: [ownerId], references: [id])
  contactId      String
  contact        Contact      @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Restrict)
  action         String // set | clear (code-validated)
  actorKind      String // merchant | otto | legacy_migration (code-validated)
  actorId        String?
  sourceKind     String // crm_ui | otto_approved_action | legacy_contact_snapshot (code-validated)
  evidenceRef    String? // opaque reference only
  idempotencyKey String
  receivedAt     DateTime     @db.Timestamptz(6)
  createdAt      DateTime     @default(now())

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, contactId, receivedAt, id])
}

// Append-only, provider-neutral refusal facts. scopeKey and every closed combination remain
// server-derived/runtime-validated; receiptRef is an opaque reference, never a copied payload.
model ProviderRefusalEvent {
  id                   String            @id
  ownerId              String
  organization         Organization      @relation(fields: [ownerId], references: [id])
  scopeKey             String
  providerConnectionId String
  providerConnection   ChannelConnection @relation(fields: [providerConnectionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  channel              String?
  contactIdentityId    String?
  contactIdentity      ContactIdentity?  @relation(fields: [contactIdentityId, ownerId], references: [id, ownerId], onDelete: Restrict)
  kind                 String // permanent_recipient | transient | account_level (code-validated)
  action               String // block | observe | clear | expire (code-validated)
  actorKind            String // provider | system (code-validated)
  actorId              String?
  providerCode         String
  receiptRef           String // opaque reference only
  reversesEventId      String?
  idempotencyKey       String
  receivedAt           DateTime          @db.Timestamptz(6)
  expiresAt            DateTime?         @db.Timestamptz(6)
  createdAt            DateTime          @default(now())

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, scopeKey, receivedAt, id])
}

// Rebuildable current refusal state for one exact server-derived scope; no independent mutation API.
model ProviderRefusalState {
  ownerId        String
  organization   Organization @relation(fields: [ownerId], references: [id])
  scopeKey       String
  blocked        Boolean
  lastEventId    String
  lastReceivedAt DateTime     @db.Timestamptz(6)

  @@unique([ownerId, scopeKey])
}

model Segment {
  id        String   @id
  ownerId   String
  organization Organization @relation(fields: [ownerId], references: [id])
  name      String
  phrase    String
  rulesJson Json
  kind      String // builtin_lifecycle | custom (code-validated)
  createdAt DateTime @default(now())
  deletedAt DateTime?

  // Segment names are unique per merchant ACROSS EVERY kind, among LIVE rows only, compared
  // case-insensitively — a PARTIAL, EXPRESSION unique index Prisma cannot express, added in
  // 20260808100000_segment_name_unique_per_owner/migration.sql (#746):
  //   ("ownerId", lower("name")) WHERE "deletedAt" IS NULL
  // `kind` is deliberately NOT in the key: the broadcast composer lists every kind and shows
  // nothing but the name, so two same-named segments of different kinds are two rows nobody
  // can tell apart. Soft delete frees the name again; two merchants may use the same name.
  @@index([ownerId, kind, deletedAt])
}

// ── C5-M1 (2026-07-21): additive-only broadcast/frequency storage ──────────────────────────
// docs/superpowers/specs/2026-07-21-c5-broadcast-eligibility-physical-contract.md §5. No send
// authority, no receipt, no merged suppression/blocklist table — the four eligibility axes stay
// separate fold-reads over the existing consent-runtime tables (ConsentStateProjection,
// ContactDndEvent, ProviderRefusalState); consent-runtime remains their sole writer. These three
// carriers only add broadcast run/audience/frequency storage. Closed taxonomies stay
// code-validated Strings (house style), matching C4b-M1.

// One merchant, one frozen audience, one logical channel account, one frozen template version,
// per §5.2. NOT send authority, NOT a receipt, NOT a suppression list, and NOT Campaign (Campaign
// only groups it, B0-51/52 — its FK is composite-tenant-qualified but the relationship is grouping
// only). Real execution stays SEND_PATH_UNAVAILABLE until D8/C6/M6 land (§6.2).
model BroadcastRun {
  id                     String       @id
  ownerId                String
  organization           Organization @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  channelScopeId         String
  channel                String
  channelScope           ChannelScope @relation(fields: [channelScopeId, ownerId, channel], references: [id, ownerId, channel], onDelete: Restrict)
  campaignId             String?
  campaign               Campaign?    @relation(fields: [campaignId, ownerId], references: [id, ownerId], onDelete: Restrict)
  templateVersionId      String?
  templateVersion        CustomerMessageTemplateVersion? @relation(fields: [templateVersionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  purpose                String // marketing | review_request (code-validated; proactive only — transactional never broadcasts, R-010 §4.3.2)
  status                 String       @default("draft") // draft | audience_frozen | confirmed | executing | completed | cancelled | failed (code-validated)
  audienceRevision       Int          @default(0) // CAS integer over the frozen audience snapshot; a new audience needs a new revision
  revision               Int          @default(0) // aggregate monotonic CAS; +1 on every status/audience mutation
  creationIdempotencyKey String // caller-supplied dedup key (house idempotencyKey shape); guards duplicate run creation on double-submit/replay
  frozenAt               DateTime?
  confirmedAt            DateTime?
  executedAt             DateTime?
  createdByMembershipId  String
  createdByMembership    Membership   @relation("BroadcastRunCreatedBy", fields: [createdByMembershipId, ownerId], references: [id, orgId], onDelete: Restrict)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  audienceMembers BroadcastAudienceMember[]

  @@unique([id, ownerId])
  @@unique([ownerId, creationIdempotencyKey])
  @@index([ownerId, status, createdAt, id], map: "BroadcastRun_owner_status_created_idx")
  @@index([ownerId, campaignId, createdAt, id], map: "BroadcastRun_owner_campaign_created_idx")
}

// Frozen audience member snapshot: one row per (run, contact identity), idempotent under retry.
// eligibilityVerdictJson is a display/audit-only snapshot taken at freeze time — §6.2 requires
// execution to RE-READ live four-axis authority, never send off a stale frozen PASS. NOT a merged
// suppression list, NOT a consent source of truth, NOT a provider receipt.
model BroadcastAudienceMember {
  id                     String          @id
  ownerId                String
  organization           Organization    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  broadcastRunId         String
  broadcastRun           BroadcastRun    @relation(fields: [broadcastRunId, ownerId], references: [id, ownerId], onDelete: Restrict)
  contactId              String
  contact                Contact         @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Restrict)
  contactIdentityId      String
  // C5-M1 P2-1 (review-driven, additive hardening beyond spec §5.3's shape): the triple FK binds
  // contactIdentityId to THIS row's own contactId (not just ownerId), so Postgres rejects a member
  // pairing one contact with a different contact's identity — closing a mis-pairing writer bug that
  // would otherwise silently charge the wrong contact's frequency cap (frequency counts on
  // contactId; broadcast idempotency counts on contactIdentityId).
  contactIdentity        ContactIdentity @relation(fields: [contactIdentityId, contactId, ownerId], references: [id, contactId, ownerId], onDelete: Restrict, map: "BroadcastAudienceMember_identity_contact_owner_fkey")
  audienceRevision       Int // the run's audienceRevision this member's snapshot belongs to
  // Frozen per-axis verdict snapshot: { consentStop, doNotDisturb, providerRefusal, frequency,
  // aggregate, evaluatedAt }, each axis { status, source, reason?, checkedAt }. Display/audit only.
  eligibilityVerdictJson Json
  verdictHash            String // versioned canonical hash of eligibilityVerdictJson (integrity)
  includedByMerchant     Boolean // merchant's audience-inclusion choice; unknown-permission members are flagged + kept (B0-44), never silently dropped
  sendState              String          @default("pending") // pending | skipped_ineligible | simulated_sent | send_unavailable (code-validated; a REAL send state never appears here in M1-M3)
  skipReason             String? // stable merchant-visible code for which axis blocked; never PII
  createdAt              DateTime        @default(now())

  @@unique([id, ownerId])
  @@unique([ownerId, broadcastRunId, contactIdentityId], map: "BroadcastAudienceMember_owner_run_identity_key")
  @@index([ownerId, broadcastRunId, sendState, id], map: "BroadcastAudienceMember_owner_run_state_idx")
}

// Append-only frequency-counting facts. The rolling window is counted by ROW COUNT over
// countedAt at read time (§5.4) — deliberately NOT a mutable single-row counter (rolling windows
// need time-based expiry, which a single count can only approximate via racy decrement/sweep).
// NOT a suppression list, NOT a consent/DND fact. Written exactly-once only when a member
// transitions into simulated_sent (simulated era) or reached-provider terminal (real era);
// skipped_ineligible/send_unavailable members never write a row (untouched sends don't spend cap).
model ContactSendFrequencyEvent {
  id             String        @id
  ownerId        String
  organization   Organization  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  contactId      String
  contact        Contact       @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Restrict)
  channel        String // provider-neutral closed taxonomy (code-validated)
  purposeClass   String // proactive_non_transactional only, for now (code-validated); frequency never gates transactional/reactive_service_reply
  sourceKind     String // broadcast_run | conversation_reply (code-validated) — which send layer produced this count
  sendRef        String // opaque ref to the send that produced this count (e.g. audience member id / conversation send id); never a receipt
  simulated      Boolean // true throughout M1-M3 (simulated sends only); a real send writes false only after M6, filtered by the attempt's own flag, never a global env/era switch
  idempotencyKey String // server-derived, frozen logical-send identity; see §5.4 for the broadcast vs. conversation-reply derivations (never collapsed to conversationId)
  occurredAt     DateTime?     @db.Timestamptz(6) // claimed business time, display only
  countedAt      DateTime      @db.Timestamptz(6) // server-canonical time; the rolling window counts on this column
  createdAt      DateTime      @default(now())

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, contactId, channel, purposeClass, countedAt, id], map: "ContactSendFrequencyEvent_window_idx")
}

// ── C6-M1 (2026-07-22): additive-only messaging receipt storage ──────────────────────────
// docs/superpowers/specs/2026-07-22-c6-receipts-reports-physical-contract.md §7. These
// carriers store verified external facts and a rebuildable per-send projection only. They add no
// sender, outbox, retry path, ledger, retention policy, or simulated receipt rows. Closed
// taxonomies remain code-validated Strings, matching the existing CRM carrier convention.

// Append-only normalized provider facts. Corrections append a new fact; rows have no update or
// delete lifecycle columns. Provider metadata remains opaque and relies on database encryption at
// rest plus the tenant boundary; no raw payload, message, phone, token, or signature is stored.
model MessageDeliveryEvent {
  id                     String            @id
  ownerId                String
  organization           Organization      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  logicalSendRef         String
  channelScopeId         String
  channel                String
  channelScope           ChannelScope      @relation(fields: [channelScopeId, ownerId, channel], references: [id, ownerId, channel], onDelete: Restrict)
  providerConnectionId   String
  providerConnection     ChannelConnection @relation(fields: [providerConnectionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  factKind               String // accepted | delivered | read | failed | replied (code-validated)
  providerCode           String // opaque provider code; never a raw payload
  externalMessageRef     String? // opaque corroborating reference only; never authority
  receiptRef             String // opaque reference only; never raw provider material
  actorKind              String // provider | system (code-validated; merchant and otto are forbidden)
  sourceEventKey         String // server-derived, event-kind-namespaced idempotency key
  sourcePayloadHash      String // versioned canonical hash
  occurredAt             DateTime?         @db.Timestamptz(6) // claimed provider time; display only
  receivedAt             DateTime          @db.Timestamptz(6) // server-canonical ordering time
  createdAt              DateTime          @default(now())

  @@unique([ownerId, sourceEventKey])
  @@index([ownerId, logicalSendRef, receivedAt, id], map: "MessageDeliveryEvent_owner_send_received_idx")
  @@index([ownerId, providerConnectionId, receivedAt, id], map: "MessageDeliveryEvent_owner_connection_received_idx")
}

// Rebuildable cache for one logical send. lastEventId is a scalar CAS cursor, matching the existing
// consent/refusal projection convention; it is not an independent authority or mutation API.
// Lifecycle is code-validated and folded monotonically by the later reconciliation writer.
model MessageDeliveryState {
  ownerId                String
  organization           Organization @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  logicalSendRef         String
  lifecycle              String // unknown | accepted | delivered | read | failed (code-validated; monotonic)
  reconciliation         String // converged | pending | conflict | timeout_unknown (code-validated)
  lastEventId            String // latest MessageDeliveryEvent.id used as the CAS cursor
  lastProviderEventAt    DateTime?    @db.Timestamptz(6) // null means unknown
  lastReconciledAt       DateTime     @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt

  @@unique([ownerId, logicalSendRef])
}

// ── C7-M1 (2026-07-22): additive-only workflows/lifecycle storage ─────────────────────────
// docs/superpowers/specs/2026-07-22-c7-workflows-lifecycle-physical-contract.md §7.
// These seven owner-scoped carriers persist deterministic rules, standing authorization facts,
// execution cursors, and business-hours policy revisions only. They add no parser/runtime, send
// path, provider adapter, receipt, outbox, consent/frequency writer, attribution table, or spend.

model WorkflowDefinition {
  id                    String       @id
  ownerId               String
  organization          Organization @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  slug                  String
  name                  String
  definitionKind        String // rule | journey (code-validated)
  originKind            String // custom | inbox_recipe (code-validated)
  recipeKey             String?
  recipeCatalogVersion  String?
  currentRevision       Int?
  currentRevisionRecord WorkflowRevision? @relation("WorkflowDefinitionCurrentRevision", fields: [ownerId, id, currentRevision], references: [ownerId, workflowDefinitionId, revision], onDelete: Restrict, map: "WorkflowDefinition_current_revision_fkey")
  rowRevision           Int          @default(0)
  status                String       @default("draft") // draft | published | archived (code-validated)
  createdByMembershipId String
  createdByMembership   Membership   @relation("WorkflowDefinitionCreatedBy", fields: [createdByMembershipId, ownerId], references: [id, orgId], onDelete: Restrict, map: "WorkflowDefinition_created_by_owner_fkey")
  archivedAt            DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  revisions WorkflowRevision[] @relation("WorkflowDefinitionRevisions")
  routines  Routine[]

  @@unique([id, ownerId])
  // Live slug uniqueness is a partial unique index in the C7-M1 migration.
  @@index([ownerId, status, updatedAt, id], map: "WorkflowDefinition_owner_status_updated_idx")
}

model WorkflowRevision {
  id                     String             @id
  ownerId                String
  organization           Organization       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  workflowDefinitionId   String
  workflowDefinition     WorkflowDefinition @relation("WorkflowDefinitionRevisions", fields: [workflowDefinitionId, ownerId], references: [id, ownerId], onDelete: Restrict, map: "WorkflowRevision_definition_owner_fkey")
  revision               Int
  formatVersion          String // fikirtive-workflow/v1 (code-validated)
  rulesSource            String
  compiledRuleJson       Json
  dependencyManifestJson Json
  dependencyHash         String
  compilerVersion        String
  contentHash            String
  validationState        String // valid | invalid | unavailable (code-validated)
  validationErrorsJson   Json
  createdByMembershipId  String
  createdByMembership    Membership @relation("WorkflowRevisionCreatedBy", fields: [createdByMembershipId, ownerId], references: [id, orgId], onDelete: Restrict, map: "WorkflowRevision_created_by_owner_fkey")
  createdAt              DateTime   @default(now())

  currentForDefinitions WorkflowDefinition[]  @relation("WorkflowDefinitionCurrentRevision")
  routines              Routine[]
  journeyStates         ContactJourneyState[]

  @@unique([id, ownerId])
  @@unique([id, ownerId, workflowDefinitionId], map: "WorkflowRevision_id_owner_definition_key")
  @@unique([ownerId, workflowDefinitionId, revision], map: "WorkflowRevision_owner_definition_revision_key")
  @@unique([ownerId, workflowDefinitionId, contentHash], map: "WorkflowRevision_owner_definition_content_key")
  @@index([ownerId, workflowDefinitionId, revision, id], map: "WorkflowRevision_owner_definition_revision_idx")
}

model Routine {
  id                       String             @id
  ownerId                  String
  organization             Organization       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  workflowDefinitionId     String
  workflowDefinition       WorkflowDefinition @relation(fields: [workflowDefinitionId, ownerId], references: [id, ownerId], onDelete: Restrict, map: "Routine_workflow_definition_owner_fkey")
  workflowRevisionId       String
  workflowRevision         WorkflowRevision   @relation(fields: [workflowRevisionId, ownerId, workflowDefinitionId], references: [id, ownerId, workflowDefinitionId], onDelete: Restrict, map: "Routine_workflow_revision_definition_fkey")
  routineKey               String
  supersedesRoutineId      String?
  supersedesRoutine        Routine?            @relation("RoutineSupersession", fields: [supersedesRoutineId, ownerId, routineKey, workflowDefinitionId], references: [id, ownerId, routineKey, workflowDefinitionId], onDelete: Restrict, map: "Routine_supersedes_owner_key_fkey")
  supersededBy             Routine[]            @relation("RoutineSupersession")
  status                   String               @default("draft") // draft | active | paused | revoked | expired
  scopeJson                Json
  scopeHash                String
  maxCreditsPerRun         Int
  maxCreditsPerMonth       Int
  summaryPolicyJson        Json
  authorizationRevision    Int
  authorizationHash        String?
  authorizedByMembershipId String?
  authorizedByMembership   Membership? @relation("RoutineAuthorizedBy", fields: [authorizedByMembershipId, ownerId], references: [id, orgId], onDelete: Restrict, map: "Routine_authorized_by_owner_fkey")
  authorizedAt             DateTime?
  expiresAt                DateTime?
  killSwitchEngaged        Boolean     @default(false)
  killedByMembershipId     String?
  killedByMembership       Membership? @relation("RoutineKilledBy", fields: [killedByMembershipId, ownerId], references: [id, orgId], onDelete: Restrict, map: "Routine_killed_by_owner_fkey")
  killedAt                 DateTime?
  killReasonCode           String?
  rowRevision              Int         @default(0)
  createdByMembershipId    String
  createdByMembership      Membership  @relation("RoutineCreatedBy", fields: [createdByMembershipId, ownerId], references: [id, orgId], onDelete: Restrict, map: "Routine_created_by_owner_fkey")
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  routineRuns   RoutineRun[]
  journeyStates ContactJourneyState[]

  @@unique([id, ownerId])
  @@unique([id, ownerId, workflowDefinitionId], map: "Routine_id_owner_definition_key")
  @@unique([id, ownerId, workflowRevisionId], map: "Routine_id_owner_revision_key")
  @@unique([id, ownerId, routineKey, workflowDefinitionId], map: "Routine_id_owner_key_definition_key")
  @@unique([id, ownerId, workflowDefinitionId, workflowRevisionId], map: "Routine_id_owner_definition_revision_key")
  @@unique([id, ownerId, routineKey, workflowDefinitionId, workflowRevisionId], map: "Routine_id_owner_key_definition_revision_key")
  @@unique([id, ownerId, routineKey, workflowDefinitionId, workflowRevisionId, authorizationRevision, authorizationHash], map: "Routine_authorization_proof_key")
  @@unique([ownerId, workflowDefinitionId, routineKey, authorizationRevision], map: "Routine_owner_definition_key_authorization_revision_key")
  // At most one active envelope per tenant + Definition-local routineKey is enforced by raw SQL.
  @@index([ownerId, status, expiresAt, id], map: "Routine_owner_status_expires_idx")
  @@index([ownerId, workflowDefinitionId, status, id], map: "Routine_owner_definition_status_idx")
}

model RoutineRun {
  id                       String              @id
