  @@unique([id, ownerId, contactJourneyStateId], map: "RoutineRun_id_owner_journey_key")
  @@unique([id, ownerId, workflowRevisionId, contactJourneyStateId], map: "RoutineRun_id_owner_revision_journey_key")
