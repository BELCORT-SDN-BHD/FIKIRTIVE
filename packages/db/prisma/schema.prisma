  contactJourneyState     ContactJourneyState? @relation(fields: [contactJourneyStateId, ownerId, workflowRevisionId], references: [id, ownerId, workflowRevisionId], onDelete: Restrict, map: "WorkflowStepExecution_journey_revision_fkey")
  contactId               String?
