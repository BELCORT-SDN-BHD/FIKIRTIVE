  routine                  Routine             @relation(fields: [routineId, ownerId, routineKey, workflowDefinitionId, workflowRevisionId, authorizationRevision, authorizationHash], references: [id, ownerId, routineKey, workflowDefinitionId, workflowRevisionId, authorizationRevision, authorizationHash], onDelete: Restrict, map: "RoutineRun_routine_authorization_fkey")
  contactJourneyStateId    String?
  contactJourneyState      ContactJourneyState? @relation("RoutineRunJourney", fields: [contactJourneyStateId, ownerId, routineId, workflowRevisionId], references: [id, ownerId, routineId, workflowRevisionId], onDelete: Restrict, map: "RoutineRun_journey_routine_revision_fkey")
  triggerKind              String // manual | schedule | customer_message | journey_due
