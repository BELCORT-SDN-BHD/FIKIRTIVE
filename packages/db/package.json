{
  "name": "@fikirtive/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./principal": {
      "types": "./dist/src/principal.d.ts",
      "default": "./dist/src/principal.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.15.0",
    "dotenv": "^17.0.0",
    "prisma": "7.8.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
