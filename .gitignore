node_modules/
.next/
dist/
packages/db/generated/
build/
*.tsbuildinfo
.env
.env.local
.env*.local
.DS_Store
.gstack/
coverage/
playwright-report/
test-results/

# resident E2E run output (#799) — traces, screenshots and the HTML report of one run
e2e/.artifacts/
e2e/.report/
.turbo/

# local dev storage (LocalDiskStorage adapter)
.data/

# prod/staging test session cookies — secret, must never be committed or shipped to a build
.prod-session.json
.staging-tenant-b-session.json

# Shared agent skills are versioned; other agent-local state stays private.
.agents/*
!.agents/skills/
!.agents/skill-sources.json
.railway/

# Graphify generated graph and extraction caches
graphify-out/
.graphify_cache/
/.graphify_*

# working drafts / scratch (underscore-prefixed) — kept on disk, out of git
_*.md
# …except Otto 技能文件柜的常驻薄层:`_core.md` 这个名字是 S1 §1 九问 4 冻结的柜子形态
# (docs/specs/otto-engine.md §7.2⑥),不是草稿。少了它,生成器与 CI 新鲜度闸都读不到柜底。
!packages/otto/knowledge/_core.md

# tool-local staging (gstack / superpowers) — not project artifacts
.out-of-scope/
.superpowers/

# Stray Claude worktree dirs must never be committed (see F32 audit)
.claire/

# Share project MCP configuration, keep other Codex state local.
.codex/*
!.codex/config.toml
