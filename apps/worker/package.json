{
  "name": "@fikirtive/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fikirtive/core": "workspace:*",
    "@fikirtive/db": "workspace:*",
    "@fikirtive/generation": "workspace:*",
    "@fikirtive/otto": "workspace:*",
    "@fikirtive/storage": "workspace:^",
    "@sentry/node": "^10.58.0",
    "execa": "^9.6.0",
    "pg-boss": "12.18.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
