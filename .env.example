# ── Database (eng review D7: Neon) ───────────────────────────────
# Local dev (docker compose up -d postgres):
DATABASE_URL="postgresql://artlio:artlio@localhost:5432/artlio"
# Neon production: direct URL here, -pooler URL below (runtime uses pooled).
# DATABASE_URL="postgresql://...@ep-xxx.neon.tech/artlio?sslmode=require"
# DATABASE_URL_POOLED="postgresql://...@ep-xxx-pooler.neon.tech/artlio?sslmode=require"

# ── Object storage (eng review D8: Cloudflare R2) ─────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=artlio

# ── Auth (design review D18: Auth.js magic link) ──────────────────
# AUTH_SECRET=            # openssl rand -base64 32
# AUTH_EMAIL_FROM=
# AUTH_EMAIL_SERVER=      # SMTP url, or use Resend adapter

# ── Modal callback (Phase 2, SOP v1.1) ────────────────────────────
