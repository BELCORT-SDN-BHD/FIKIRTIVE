# ── Database (eng review D7: Neon) ───────────────────────────────
# Local dev (docker compose up -d postgres):
DATABASE_URL="postgresql://artlio:artlio@localhost:5432/artlio"
# Neon production: direct URL here, -pooler URL below (runtime uses pooled).
# DATABASE_URL="postgresql://...@ep-xxx.neon.tech/artlio?sslmode=require"
# DATABASE_URL_POOLED="postgresql://...@ep-xxx-pooler.neon.tech/artlio?sslmode=require"
#   ↑ runtime MUST be the -pooler endpoint (PgBouncer). Under Prisma 7 driver-adapters
#     the app pool size is the pg Pool `max` set in code (packages/db/src/index.ts), NOT
#     the `connection_limit` URL param. Tune DB_POOL_MAX so (replica_count × max) stays
#     under Neon's pooled connection budget; defaults to 10/process when unset.
# DB_POOL_MAX="10"

# ── Object storage (eng review D8: Cloudflare R2) ─────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=artlio

# ── Auth (design review D18: Auth.js magic link) ──────────────────
# AUTH_SECRET=            # openssl rand -base64 32
# AUTH_EMAIL_FROM=
# AUTH_EMAIL_SERVER=      # SMTP url, or use Resend adapter

# ── Modal callback (Phase 2, SOP v1.1) ────────────────────────────
# MODAL_CALLBACK_SECRET=
# ARTLIO_CALLBACK_BASE=

# ── Auth (D18: email magic link) ──────────────────────────────────
AUTH_SECRET=""                       # openssl rand -base64 32
AUTH_ALLOWED_EMAILS="you@email.com"  # comma-separated allowlist (deny by default)
# RESEND_API_KEY=""                  # production magic-link sender (resend.com) — REQUIRED in prod
# AUTH_EMAIL_FROM="Artlio <auth@yourdomain.com>"  # verified Resend sender

# ── Auth enforcement (the login wall) ─────────────────────────────
AUTH_URL="http://localhost:3100"     # canonical origin — magic-link callbacks + session cookies bind to it
FOUNDER_ADMIN_EMAILS="you@email.com" # comma-separated founder / super-admins (seeded to super-admin on sign-in)
# AUTH_ENABLED gates every page behind login. In PRODUCTION the wall is ON unless
# explicitly set to "false" (fail-closed — a deploy that forgets it stays protected).
# In dev it is OFF unless set to "true".
AUTH_ENABLED="true"

# ── Otto agent (LLM) — REQUIRED for the Otto loop ─────────────────
ANTHROPIC_API_KEY=""
# ANTHROPIC_BASE_URL=""              # optional gateway/proxy base URL

# ── Generation provider (SPEND) ───────────────────────────────────
# "mock" (default, $0 — safe everywhere), "byteplus" (REAL money — the prod path
# since #67), or "fal" (REAL money — legacy fallback). Anything unrecognized
# resolves to the mock, so a misconfigured deploy can never silently burn money.
GENERATION_PROVIDER="mock"
COWORK_PROVIDER="mock"               # legacy cowork-planner transport (mock | fal | modal)
# FAL_KEY=""                         # REQUIRED only when GENERATION_PROVIDER=fal
# BYTEPLUS_API_KEY=""                # REQUIRED when GENERATION_PROVIDER=byteplus (Ark key, prefix ark-)
# BYTEPLUS_RESOURCE_PACK_USD=""      # Total prepaid Seedance pack value on effective COGS basis, e.g. 35.64
# BYTEPLUS_RESOURCE_PACK_USED_USD="" # Optional console-read used amount; unset = admin estimates from frozen spend snapshots
# BYTEPLUS_RESOURCE_PACK_ALERT_PCT="20" # Admin System Health warns at or below this remaining percentage
# OTTO_DEFAULT_VIDEO_MODEL="seedance-2-fast"  # optional — the code fallback IS seedance-2-fast
#                                    # (2026-07-04: only flat margin-floored models are honored;
#                                    # a non-flat value degrades to seedance-2-fast with a warn).

# ── Storage driver (T4) ───────────────────────────────────────────
# local (default): .data/storage on disk — dev only
# r2: Cloudflare R2 via S3 API (MinIO-compatible for local verification)
# STORAGE_DRIVER="r2"
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="artlio"

# ── Better Auth (dormant foundation; not wired until cutover) ────────
BETTER_AUTH_SECRET=""                  # openssl rand -base64 32 (distinct from AUTH_SECRET)
BETTER_AUTH_URL="http://localhost:3100" # canonical origin — match AUTH_URL
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3100" # browser client (public origin)
GOOGLE_CLIENT_ID=""                    # Google OAuth app (registered by ops before cutover)
GOOGLE_CLIENT_SECRET=""
# Reuses existing RESEND_API_KEY / AUTH_EMAIL_FROM / FOUNDER_ADMIN_EMAILS / AUTH_ALLOWED_EMAILS

# ── Stripe (billing LIVE since MYR credit packs) ─────────────────────
# 2026-07-04 审计补录:计费早已 LIVE 但这两把钥匙从未进过 env 清单 —— 换机器/
# 重建环境时会漏配,checkout 与充值入账(webhook)会静默失效。
# STRIPE_SECRET_KEY=""               # sk_live_… (Railway prod) / sk_test_… (dev)
# STRIPE_WEBHOOK_SECRET=""           # whsec_… — webhook signature IS the auth; wrong = all grants 400

# ── Observability (2026-07-04 盲区修复) ──────────────────────────────
# /api/health(免鉴权)返回 { ok, db, worker } — 外部监控(UptimeRobot 等)探测它;
# worker 每 60s 写 WorkerHeartbeat,5 分钟无心跳 = "stale"。接法见
# docs/ops/incident-visibility.md。
# APP_ORIGIN="https://app.fikirtive.com" # Meta data-deletion 回调返回给用户的确认页 origin(未设时用请求 origin)
