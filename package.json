{
  "name": "fikirtive",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:tenancy": "bash scripts/check-no-raw-prisma.sh",
    "lint:skills": "bash scripts/check-skill-imports.sh",
    "lint:parity": "corepack pnpm --filter @fikirtive/otto build && bash scripts/check-parity.sh",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @fikirtive/db generate",
    "db:migrate": "pnpm --filter @fikirtive/db migrate:dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "playwright": "^1.60.0"
  }
}
